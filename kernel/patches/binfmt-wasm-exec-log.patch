+/*
+ * collabo.execlog=1 on the command line reports every exec of a wasm program
+ * to the host (kernel.exec_log), for its command history. Off by default, and
+ * then nothing is copied. A record is cut at WASM_EXEC_LOG_MAX bytes: argv may
+ * be up to WASM_ARG_LIMIT, and the host only keeps a line of it.
+ */
+#define WASM_EXEC_LOG_MAX SZ_4K
+static bool exec_log __ro_after_init;
+
+static int __init exec_log_setup(char *value)
+{
+	if (kstrtobool(value, &exec_log))
+		pr_warn("collabo.execlog=%s: expected 0 or 1\n", value);
+	return 1;
+}
+__setup("collabo.execlog=", exec_log_setup);
+
 /*
  * The process_args member is the userspace ABI. Everything before it is
  * kernel-private exec state, and process_size is the exact byte range copied
@@ -263,6 +283,58 @@ static void relocate_args(struct wasm_exec_args *exec,
 			       process_offset(exec, template->envp));
 }
 
+static size_t exec_log_put(char *record, size_t at, const char *bytes,
+			   size_t len)
+{
+	len = min(len, WASM_EXEC_LOG_MAX - at);
+	if (len)
+		memcpy(record + at, bytes, len);
+	return at + len;
+}
+
+/*
+ * Tells the host about an exec of bprm: done (error 0, with exec's argv) or
+ * failed with error after the file was found to be a wasm program (no argv;
+ * an E2BIG argv is what failed). Best effort: no memory, no record.
+ */
+static void report_exec(struct linux_binprm *bprm,
+			struct wasm_exec_args *exec, int error)
+{
+	const char *argv = NULL, *cwd = "?";
+	size_t argv_len = 0, cwd_len, file_len, len;
+	char *record, *path;
+	struct path pwd;
+
+	if (!exec_log)
+		return;
+	record = kmalloc(WASM_EXEC_LOG_MAX, GFP_KERNEL);
+	path = kmalloc(PATH_MAX, GFP_KERNEL);
+	if (!record || !path)
+		goto out;
+
+	get_fs_pwd(current->fs, &pwd);
+	cwd = d_path(&pwd, path, PATH_MAX);
+	path_put(&pwd);
+	if (IS_ERR(cwd))
+		cwd = "?";
+	if (exec) {
+		argv = (const char *)&exec->process + exec->arg_start;
+		argv_len = exec->arg_end - exec->arg_start;
+	}
+	cwd_len = strlen(cwd) + 1;
+	file_len = strlen(bprm->filename) + 1;
+
+	len = exec_log_put(record, 0, cwd, cwd_len);
+	len = exec_log_put(record, len, bprm->filename, file_len);
+	len = exec_log_put(record, len, argv, argv_len);
+	wasm_kernel_exec_log(task_tgid_vnr(current),
+			     from_kuid_munged(current_user_ns(), current_uid()),
+			     error, record, len, cwd_len + file_len + argv_len);
+out:
+	kfree(path);
+	kfree(record);
+}
