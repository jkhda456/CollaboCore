+/*
+ * Extended attributes, kept in memory as tmpfs keeps them. Without them overlayfs cannot make a
+ * directory of its upper layer opaque, so removing a lower directory and creating one of the
+ * same name failed with EIO (tmpfs is ramfs without an MMU). An inode's list is allocated with
+ * its first attribute and hangs off i_private, which ramfs does not otherwise use; setting one
+ * holds the inode lock, reading one does not.
+ */
+static struct list_head *ramfs_xattrs(struct inode *inode)
+{
+	return smp_load_acquire((struct list_head **)&inode->i_private);
+}
+
+static int ramfs_xattr_get(const struct xattr_handler *handler,
+			   struct dentry *unused, struct inode *inode,
+			   const char *suffix, void *value, size_t size)
+{
+	struct ramfs_fs_info *fsi = inode->i_sb->s_fs_info;
+	struct list_head *xattrs = ramfs_xattrs(inode);
+
+	if (!xattrs)
+		return -ENODATA;
+	return simple_xattr_get(&fsi->xattr_cache, xattrs,
+				xattr_full_name(handler, suffix), value, size);
+}
+
+static int ramfs_xattr_set(const struct xattr_handler *handler,
+			   struct mnt_idmap *idmap, struct dentry *unused,
+			   struct inode *inode, const char *suffix,
+			   const void *value, size_t size, int flags)
+{
+	struct ramfs_fs_info *fsi = inode->i_sb->s_fs_info;
+	struct list_head *xattrs = ramfs_xattrs(inode);
+	struct simple_xattr *old_xattr;
+
+	if (!xattrs) {
+		if (!value)
+			return (flags & XATTR_REPLACE) ? -ENODATA : 0;
+		xattrs = kmalloc_obj(*xattrs);
+		if (!xattrs)
+			return -ENOMEM;
+		INIT_LIST_HEAD(xattrs);
+		smp_store_release((struct list_head **)&inode->i_private, xattrs);
+	}
+	old_xattr = simple_xattr_set(&fsi->xattr_cache, xattrs,
+				     xattr_full_name(handler, suffix), value,
+				     size, flags);
+	if (IS_ERR(old_xattr))
+		return PTR_ERR(old_xattr);
+	simple_xattr_free_rcu(old_xattr);
+	inode_set_ctime_current(inode);
+	return 0;
+}
+
+static const struct xattr_handler ramfs_trusted_xattr_handler = {
+	.prefix = XATTR_TRUSTED_PREFIX,
+	.get = ramfs_xattr_get,
+	.set = ramfs_xattr_set,
+};
+
+static const struct xattr_handler ramfs_user_xattr_handler = {
+	.prefix = XATTR_USER_PREFIX,
+	.get = ramfs_xattr_get,
+	.set = ramfs_xattr_set,
+};
+
+static const struct xattr_handler * const ramfs_xattr_handlers[] = {
+	&ramfs_trusted_xattr_handler,
+	&ramfs_user_xattr_handler,
+	NULL
+};
+
+ssize_t ramfs_listxattr(struct dentry *dentry, char *buffer, size_t size)
+{
+	struct inode *inode = d_inode(dentry);
+
+	return simple_xattr_list(inode, ramfs_xattrs(inode), buffer, size);
+}
+
+static void ramfs_evict_inode(struct inode *inode)
+{
+	struct ramfs_fs_info *fsi = inode->i_sb->s_fs_info;
+	struct list_head *xattrs = inode->i_private;
+
+	truncate_inode_pages_final(&inode->i_data);
+	clear_inode(inode);
+	if (xattrs) {
+		simple_xattrs_free(&fsi->xattr_cache, xattrs, NULL);
+		kfree(xattrs);
+	}
+}
+
 struct inode *ramfs_get_inode(struct super_block *sb,
 				const struct inode *dir, umode_t mode, dev_t dev)
 {
@@ -186,6 +279,34 @@ static int ramfs_tmpfile(struct mnt_idmap *idmap,
