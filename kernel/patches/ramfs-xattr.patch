+/*
+ * RENAME_WHITEOUT, as tmpfs has it: overlayfs leaves a whiteout (a 0/0 character device) where
+ * the name was in the same step, rather than making one in its work directory and renaming it.
+ */
+static int ramfs_rename(struct mnt_idmap *idmap, struct inode *old_dir,
+			struct dentry *old_dentry, struct inode *new_dir,
+			struct dentry *new_dentry, unsigned int flags)
+{
+	struct dentry *whiteout;
+	int error;
+
+	if (!(flags & RENAME_WHITEOUT))
+		return simple_rename(idmap, old_dir, old_dentry, new_dir,
+				     new_dentry, flags);
+	if (!simple_empty(new_dentry))
+		return -ENOTEMPTY;
+	whiteout = d_alloc(old_dentry->d_parent, &old_dentry->d_name);
+	if (!whiteout)
+		return -ENOMEM;
+	error = ramfs_mknod(idmap, old_dir, whiteout, S_IFCHR | WHITEOUT_MODE,
+			    WHITEOUT_DEV);
+	dput(whiteout);
+	if (error)
+		return error;
+	return simple_rename(idmap, old_dir, old_dentry, new_dir, new_dentry,
+			     flags & ~RENAME_WHITEOUT);
+}
