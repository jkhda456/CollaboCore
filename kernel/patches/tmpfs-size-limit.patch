+/*
+ * Used is this mount's files; available is what both its own limit and the shared one still
+ * allow, so every mount shows the same room while the shared limit is the nearer one. With
+ * neither limit, zeros, as ramfs always gave.
+ */
+static int ramfs_statfs(struct dentry *dentry, struct kstatfs *buf)
+{
+	struct ramfs_fs_info *fsi = dentry->d_sb->s_fs_info;
+	unsigned long max = READ_ONCE(fsi->mount_opts.max_pages);
+	unsigned long limit = ramfs_limit_pages();
+	long used = max(atomic_long_read(&fsi->used), 0L);
+	long all = max(atomic_long_read(&ramfs_used), 0L);
+	unsigned long avail = ULONG_MAX;
+
+	simple_statfs(dentry, buf);
+	if (max)
+		avail = max > used ? max - used : 0;
+	if (limit)
+		avail = min(avail, limit > all ? limit - all : 0);
+	if (avail != ULONG_MAX) {
+		buf->f_blocks = used + avail;
+		buf->f_bfree = buf->f_bavail = avail;
+	}
 	return 0;
 }
 
