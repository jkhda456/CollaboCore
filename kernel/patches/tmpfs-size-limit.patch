+/* A remount changes size= (not below what the mount holds, as on tmpfs); mode stays. */
+static int ramfs_reconfigure(struct fs_context *fc)
+{
+	struct ramfs_fs_info *new = fc->s_fs_info;
+	struct ramfs_fs_info *fsi = fc->root->d_sb->s_fs_info;
+	unsigned long max = new->mount_opts.max_pages;
+
+	if (!new->mount_opts.size_given)
+		return 0;
+	if (max && atomic_long_read(&fsi->used) > (long)max)
+		return invalfc(fc, "Too small a size for current use");
+	WRITE_ONCE(fsi->mount_opts.max_pages, max);
+	return 0;
+}
