+/*
+ * Limits. Without CONFIG_SHMEM (nommu) tmpfs is this filesystem, and ramfs has none: files in /tmp,
+ * an overlay's upper layer or the root could take all of memory, and with no swap and nothing the
+ * OOM killer could free, that ends the machine. Every ramfs and tmpfs mount, the root's too, shares
+ * one limit, ramfs.limit: half of RAM unless the kernel command line or
+ * /sys/module/ramfs/parameters/limit says otherwise (a size, N% of RAM, or 0 for none). A mount
+ * also takes tmpfs's size= (bytes, k/m/g, or N% of RAM; a remount changes it) for a limit of its
+ * own. A new page of a file past either is ENOSPC.
+ *
+ * A file's pages are counted in its i_blocks (du and stat show them, as on tmpfs). Pages leave the
+ * page cache by truncation, eviction and invalidation, and a read of a hole adds one, so the counts
+ * are brought to the page cache's own (nrpages) whenever a file is written, truncated or evicted,
+ * as shmem does with its alloced count.
+ */
+#define RAMFS_BLOCKS_PER_PAGE	(PAGE_SIZE / 512)
+
+static unsigned int ramfs_limit_percent = 50;	/* of RAM; 0: ramfs_limit_bytes */
+static unsigned long long ramfs_limit_bytes;	/* 0 with no percent: no limit */
+static atomic_long_t ramfs_used = ATOMIC_LONG_INIT(0);
+
+static unsigned long ramfs_limit_pages(void)
+{
+	unsigned int percent = READ_ONCE(ramfs_limit_percent);
+
+	if (percent)
+		return mult_frac(totalram_pages(), percent, 100);
+	return READ_ONCE(ramfs_limit_bytes) >> PAGE_SHIFT;
+}
+
+static int ramfs_limit_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned long long size;
+	char *rest;
+	bool percent;
+
+	size = memparse(val, &rest);
+	percent = *rest == '%';
+	rest += percent;
+	if (*rest == '\n')
+		rest++;
+	if (rest == val || *rest || (percent && size > 100))
+		return -EINVAL;
+	WRITE_ONCE(ramfs_limit_percent, percent ? size : 0);
+	WRITE_ONCE(ramfs_limit_bytes, percent ? 0 : size);
+	return 0;
+}
+
+static int ramfs_limit_get(char *buffer, const struct kernel_param *kp)
+{
+	unsigned int percent = READ_ONCE(ramfs_limit_percent);
+
+	if (percent)
+		return scnprintf(buffer, PAGE_SIZE, "%u%%\n", percent);
+	return scnprintf(buffer, PAGE_SIZE, "%llu\n", READ_ONCE(ramfs_limit_bytes));
+}
+
+static const struct kernel_param_ops ramfs_limit_ops = {
+	.set = ramfs_limit_set,
+	.get = ramfs_limit_get,
+};
+module_param_cb(limit, &ramfs_limit_ops, NULL, 0644);
+MODULE_PARM_DESC(limit, "most memory all ramfs and tmpfs files together may use: bytes (k, m, g), N% of RAM, 0 for no limit (default 50%)");
+
+/* Pages that are already there (or gone): counted, never refused. */
+static void ramfs_account(struct ramfs_fs_info *fsi, long pages)
+{
+	atomic_long_add(pages, &fsi->used);
+	atomic_long_add(pages, &ramfs_used);
+}
+
+/* Takes pages for new pages of a file, or ENOSPC past the mount's limit or the shared one. */
+int ramfs_charge(struct inode *inode, long pages)
+{
+	struct ramfs_fs_info *fsi = inode->i_sb->s_fs_info;
+	unsigned long max = READ_ONCE(fsi->mount_opts.max_pages);
+	unsigned long limit = ramfs_limit_pages();
+
+	if ((unsigned long)atomic_long_add_return(pages, &fsi->used) > max && max)
+		goto full;
+	if ((unsigned long)atomic_long_add_return(pages, &ramfs_used) > limit && limit) {
+		atomic_long_sub(pages, &ramfs_used);
+		goto full;
+	}
+	spin_lock(&inode->i_lock);
+	inode->i_blocks += (blkcnt_t)pages * RAMFS_BLOCKS_PER_PAGE;
+	spin_unlock(&inode->i_lock);
+	return 0;
+full:
+	atomic_long_sub(pages, &fsi->used);
+	return -ENOSPC;
+}
+
+/* Brings the file's count, and the mount's and the shared one with it, to its page cache's. */
+void ramfs_recalc(struct inode *inode)
+{
+	long delta;
+
+	spin_lock(&inode->i_lock);
+	delta = (long)READ_ONCE(inode->i_mapping->nrpages) -
+		(long)(inode->i_blocks / RAMFS_BLOCKS_PER_PAGE);
+	/* in 64 bits: delta * an unsigned long is a huge 32-bit number when pages left */
+	inode->i_blocks += (blkcnt_t)delta * RAMFS_BLOCKS_PER_PAGE;
+	spin_unlock(&inode->i_lock);
+	if (delta)
+		ramfs_account(inode->i_sb->s_fs_info, delta);
+}
+
+/*
+ * Only a hole is read in: ramfs keeps the zeroed page in the file (tmpfs reads holes without one),
+ * so reading a sparse file could fill memory too. It is a new page within the limits like a
+ * written one, and past them the read fails with ENOSPC. The folio, unlocked and not uptodate,
+ * stays in the cache for the next read to try again; recalc counts it meanwhile.
+ */
+static int ramfs_read_folio(struct file *file, struct folio *folio)
+{
+	int err = ramfs_charge(folio->mapping->host, folio_nr_pages(folio));
+
+	if (err) {
+		folio_unlock(folio);
+		return err;
+	}
+	return ram_aops.read_folio(file, folio);
+}
+
+/* Writes hold the inode lock: no recalc runs between the charge and the folio's arrival. */
+static int ramfs_write_begin(const struct kiocb *iocb, struct address_space *mapping,
+			     loff_t pos, unsigned len, struct folio **foliop, void **fsdata)
+{
+	struct inode *inode = mapping->host;
+	struct folio *folio;
+	int err;
+
+	ramfs_recalc(inode);
+	folio = filemap_get_folio(mapping, pos >> PAGE_SHIFT);
+	if (IS_ERR(folio)) {
+		err = ramfs_charge(inode, 1);
+		if (err)
+			return err;
+	} else {
+		folio_put(folio);
+	}
+	/* if this fails, the next recalc gives the page back */
+	return simple_write_begin(iocb, mapping, pos, len, foliop, fsdata);
+}
+
+static int ramfs_write_end(const struct kiocb *iocb, struct address_space *mapping,
+			   loff_t pos, unsigned len, unsigned copied,
+			   struct folio *folio, void *fsdata)
+{
+	return ram_aops.write_end(iocb, mapping, pos, len, copied, folio, fsdata);
+}
+
+static const struct address_space_operations ramfs_aops = {
+	.read_folio	= ramfs_read_folio,
+	.write_begin	= ramfs_write_begin,
+	.write_end	= ramfs_write_end,
+	.dirty_folio	= noop_dirty_folio,
+};
