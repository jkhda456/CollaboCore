+static struct ignorefile *load_ignorefile(const char *file, const char *base, char *up)
+{
+	struct ignorefile *ig;
+	struct pat **tail;
+	FILE *fp;
+	char *line;
+
+	fp = fopen_for_read(file);
+	if (!fp)
+		return NULL;
+	ig = xzalloc(sizeof(*ig));
+	ig->base = xstrdup(base);
+	ig->up = up;
+	tail = &ig->pats;
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		char *s = line, *sl;
+		struct pat *p;
+
+		gittrim(s);
+		if (s[0] == '#' || !s[0]) {
+			free(line);
+			continue;
+		}
+		p = xzalloc(sizeof(*p));
+		if (s[0] == '!') {
+			p->negate = 1;
+			s++;
+		} else if (s[0] == '\\' && (s[1] == '!' || s[1] == '#'))
+			s++;
+		sl = strchr(s, '/');
+		p->anchored = (sl && sl[1]);
+		if (s[0] == '/')
+			s++;
+		p->pattern = xstrdup(s);
+		free(line);
+		*tail = p;
+		tail = &p->next;
+	}
+	fclose(fp);
+	return ig;
+}
