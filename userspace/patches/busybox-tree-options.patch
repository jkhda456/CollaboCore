+			if (G.p)
+				fprintf(G.out, ",\"mode\":\"%04o\",\"prot\":\"%s\"", (unsigned)(e->mode & 07777), prot(e->mode));
+			if (G.u)
+				fprintf(G.out, ",\"user\":\"%s\"", uid2uname_utoa(e->uid));
+			if (G.g)
+				fprintf(G.out, ",\"group\":\"%s\"", gid2group_utoa(e->gid));
+			if (G.s) {
+				if (G.h || G.si) {
+					char nbuf[64];
+					psize(nbuf, e->size);
+					fprintf(G.out, ",\"size\":\"%s\"", skip_whitespace(nbuf));
+				} else
+					fprintf(G.out, ",\"size\":%lld", (long long)e->size);
+			}
+			if (G.D)
+				fprintf(G.out, ",\"time\":\"%s\"", do_date(G.c ? e->ctime : e->mtime));
+			if (e->isdir && e->err)
+				descend = 1;
+		}
+		if (descend)
+			fputs(",\"contents\":[", G.out);
+		else
+			putc('}', G.out);
+		return descend;
