+static void json_encode(const char *s)
+{
+	static const char ctrl[] ALIGN1 = "0-------btn-fr------------------";
+	for (; *s; s++) {
+		unsigned char c = *s;
+		if (c < 32) {
+			if (ctrl[c] != '-')
+				fprintf(G.out, "\\%c", ctrl[c]);
+			else
+				fprintf(G.out, "\\u%04x", c);
+		} else if (c == '"' || c == '\\')
+			fprintf(G.out, "\\%c", c);
+		else
+			putc(c, G.out);
+	}
+}
