+/* The entries of DIR left after the filters, unsorted; *n: how many, -1 when DIR cannot be read */
+static struct ent **read_dir(const char *dir, ssize_t *n)
+{
+	struct ent **dl = NULL;
+	struct dirent *de;
+	DIR *d;
+	size_t p = 0;
+
+	*n = -1;
+	d = opendir(dir);
+	if (!d)
+		return NULL;
+	while ((de = readdir(d)) != NULL) {
+		struct ent *e;
+		char *path;
+
+		if (DOT_OR_DOTDOT(de->d_name))
+			continue;
+		if (!G.a && de->d_name[0] == '.')
+			continue;
+		path = path_join(dir, de->d_name);
+		e = getinfo(de->d_name, path);
+		free(path);
+		if (e) {
+			dl = xrealloc_vector(dl, 6, p);
+			dl[p++] = e;
+		}
+	}
+	closedir(d);
+	*n = p;
+	if (p == 0) {
+		free(dl);
+		return NULL;
+	}
+	dl[p] = NULL;
+	return dl;
+}
