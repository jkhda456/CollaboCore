+static int psize(char *buf, off_t size)
+{
+	static const char iec[] ALIGN1 = "BKMGTPEZY";
+	static const char si[] ALIGN1 = "dkMGTPEZY";
+	const char *unit = G.si ? si : iec;
+	int idx, usize = G.si ? 1000 : 1024;
+
+	if (G.h || G.si) {
+		for (idx = size < usize ? 0 : 1; size >= (off_t)usize * usize; idx++, size /= usize)
+			continue;
+		if (!idx)
+			return sprintf(buf, " %4d", (int)size);
+		return sprintf(buf, ((size + 52) / usize >= 10) ? " %3.0f%c" : " %3.1f%c",
+				(float)size / (float)usize, unit[idx]);
+	}
+	return sprintf(buf, " %11lld", (long long)size);
+}
