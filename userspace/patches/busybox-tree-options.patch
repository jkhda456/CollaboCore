+static char ftype_char(mode_t mode)
+{
+	if (!G.d && S_ISDIR(mode))
+		return '/';
+	if (S_ISSOCK(mode))
+		return '=';
+	if (S_ISFIFO(mode))
+		return '|';
+	if (S_ISLNK(mode))
+		return '@';
+	if (S_ISREG(mode) && (mode & (S_IXUSR | S_IXGRP | S_IXOTH)))
+		return '*';
+	return 0;
+}
