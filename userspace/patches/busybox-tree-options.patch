+/* NAME or, with checkpaths, PATH or any part of it after a / */
+static int patlist(const char **pats, int npats, const char *name, int isdir, int checkpaths)
+{
+	int k;
+	for (k = 0; k < npats; k++) {
+		const char *pc;
+		if (patmatch(name, pats[k], isdir) == 1)
+			return 1;
+		if (!checkpaths)
+			continue;
+		for (pc = strchr(name, '/'); pc && *pc; pc = strchr(pc + 1, '/'))
+			if (patmatch(pc + 1, pats[k], isdir) == 1)
+				return 1;
+	}
+	return 0;
+}
