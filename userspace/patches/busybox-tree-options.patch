+		fprintf(G.out, "{\"type\":\"%s\"", ftype_name(e ? e->mode : 0));
+		return;
+	}
+	fillinfo(info, e);
+	if (G.metafirst) {
+		if (info[0] == '[')
+			fprintf(G.out, "%s  ", info);
+		if (!G.i)
+			indent(level);
+	} else {
+		if (!G.i)
+			indent(level);
+		if (info[0] == '[')
+			fprintf(G.out, "%s  ", info);
+	}
+}
