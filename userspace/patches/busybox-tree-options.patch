+/* UTF-8 sequence length at S, 0 when it is not valid UTF-8; *cp: the code point */
+static int utf8_len(const unsigned char *s, unsigned *cp)
+{
+	int len, k;
+	unsigned c = s[0];
+
+	if (c < 0x80) { *cp = c; return 1; }
+	if (c < 0xc2) return 0;
+	if (c < 0xe0) { len = 2; c &= 0x1f; }
+	else if (c < 0xf0) { len = 3; c &= 0x0f; }
+	else if (c < 0xf5) { len = 4; c &= 0x07; }
+	else return 0;
+	for (k = 1; k < len; k++) {
+		if ((s[k] & 0xc0) != 0x80)
+			return 0;
+		c = (c << 6) | (s[k] & 0x3f);
+	}
+	*cp = c;
+	return len;
+}
+
+static int valid_utf8(const char *s)
+{
+	unsigned cp;
+	while (*s) {
+		int len = utf8_len((const unsigned char *)s, &cp);
+		if (!len)
+			return 0;
+		s += len;
+	}
+	return 1;
+}
+
+/* A name, as tree prints it: unprintable characters as \ooo (-q: ?, -N: as they are) */
+static void printit(const char *s)
+{
+	FILE *out = G.out;
+
+	if (G.N) {
+		fprintf(out, G.Q ? "\"%s\"" : "%s", s);
+		return;
+	}
+	if (G.Q)
+		putc('"', out);
+	if (G.utf8 && valid_utf8(s)) {
+		while (*s) {
+			unsigned cp;
+			int len = utf8_len((const unsigned char *)s, &cp);
+			if (cp >= 0x20 && cp != 0x7f && !(cp >= 0x80 && cp < 0xa0))
+				fwrite(s, 1, len, out);
+			else if (G.q)
+				putc('?', out);
+			else
+				fprintf(out, "\\%03o", cp);
+			s += len;
+		}
+	} else {
+		for (; *s; s++) {
+			int c = (unsigned char)*s;
+			if ((c >= 7 && c <= 13) || c == '\\' || (c == '"' && G.Q) || (c == ' ' && !G.Q)) {
+				putc('\\', out);
+				putc(c > 13 ? c : "abtnvfr"[c - 7], out);
+			} else if (c >= 0x20 && c < 0x7f)
+				putc(c, out);
+			else if (G.q)
+				putc((G.utf8 && c > 127) ? c : '?', out);
+			else
+				fprintf(out, "\\%03o", c);
+		}
+	}
+	if (G.Q)
+		putc('"', out);
+}
