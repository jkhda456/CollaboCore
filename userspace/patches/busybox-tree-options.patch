+/* ---- sorting */
+
+static int basecmp(const struct ent *a, const struct ent *b)
+{
+	int v;
+	switch (G.basesort) {
+	case SORT_VERSION:
+		v = strverscmp(a->name, b->name);
+		break;
+	case SORT_SIZE:
+		v = a->size == b->size ? 0 : (a->size < b->size ? 1 : -1);
+		if (v == 0)
+			v = strcmp(a->name, b->name);
+		break;
+	case SORT_MTIME:
+	case SORT_CTIME: {
+		time_t ta = G.basesort == SORT_MTIME ? a->mtime : a->ctime;
+		time_t tb = G.basesort == SORT_MTIME ? b->mtime : b->ctime;
+		v = ta == tb ? strcmp(a->name, b->name) : (ta < tb ? -1 : 1);
+		break;
+	}
+	default:
+		v = strcmp(a->name, b->name);
+	}
+	return G.reverse ? -v : v;
+}
