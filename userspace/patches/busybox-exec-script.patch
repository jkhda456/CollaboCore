diff --git a/libbb/executable.c b/libbb/executable.c
index 09bed1e..17fa062 100644
--- a/libbb/executable.c
+++ b/libbb/executable.c
@@ -78,15 +78,80 @@ int FAST_FUNC executable_exists(const char *name)
 	return ret != NULL;
 }
 
-#if ENABLE_FEATURE_PREFER_APPLETS
-/* just like the real execvp, but try to launch an applet named 'file' first */
+/* What execvp does after execve fails with ENOEXEC, as POSIX wants of it ("the execlp() and
+ * execvp() functions shall execute a command interpreter and the environment of the executed
+ * command shall be as if the process invoked the sh utility") and glibc's does: the file run by
+ * /bin/sh, its arguments after it. musl's execvp fails with ENOEXEC instead, so a script without
+ * #! could not be run by hush, env, xargs, find -exec, ... As bash does, a file with a NUL byte
+ * in its first 80 bytes is not taken for a script (a program of another machine): ENOEXEC stays.
+ * No malloc: this runs in the child of a vfork. */
+static void exec_as_script(const char *file, char *const argv[])
+{
+	char buf[PATH_MAX];
+	const char *path = file;
+	int fd, n, argc;
+
+	if (!argv[0])
+		goto out;
+	if (!strchr(file, '/')) {
+		/* the PATH entry execvp took: the first with an executable file of that name */
+		const char *p = getenv("PATH");
+		if (!p)
+			p = bb_default_path;
+		path = NULL;
+		while (*p) {
+			const char *end = strchrnul(p, ':');
+			size_t len = end - p;
+			if (len + 1 + strlen(file) < sizeof(buf)) {
+				memcpy(buf, p, len);
+				buf[len] = '/';
+				strcpy(buf + len + (len != 0), file);
+				if (file_is_executable(buf)) {
+					path = buf;
+					break;
+				}
+			}
+			p = *end ? end + 1 : end;
+		}
+		if (!path)
+			goto out;
+	}
+	fd = open(path, O_RDONLY);
+	if (fd < 0)
+		goto out;
+	{
+		char head[80];
+		n = full_read(fd, head, sizeof(head));
+		close(fd);
+		if (n < 0 || memchr(head, '\0', n))
+			goto out;
+	}
+	for (argc = 0; argv[argc]; argc++)
+		continue;
+	{
+		char *nargv[argc + 2];
+		nargv[0] = (char *)"sh";
+		nargv[1] = (char *)path;
+		memcpy(nargv + 2, argv + 1, sizeof(nargv[0]) * argc); /* argv[1..], and its NULL */
+		execv("/bin/sh", nargv);
+	}
+ out:
+	errno = ENOEXEC;
+}
+
+/* execvp, which runs a file without #! as a shell script (exec_as_script); with
+ * FEATURE_PREFER_APPLETS, an applet named 'file' first */
 int FAST_FUNC BB_EXECVP(const char *file, char *const argv[])
 {
+#if ENABLE_FEATURE_PREFER_APPLETS
 	if (find_applet_by_name(file) >= 0)
 		execvp(bb_busybox_exec_path, argv);
-	return execvp(file, argv);
-}
 #endif
+	execvp(file, argv);
+	if (errno == ENOEXEC)
+		exec_as_script(file, argv);
+	return -1;
+}
 
 void FAST_FUNC BB_EXECVP_or_die(char **argv)
 {
diff --git a/shell/hush.c b/shell/hush.c
index 0811336..cfff36d 100644
