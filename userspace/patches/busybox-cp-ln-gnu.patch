+/* the name to move PATH to before it is replaced, or NULL for none: PATH~ (or PATH SUFFIX,
+ * $SIMPLE_BACKUP_SUFFIX), or PATH.~N~ one past the highest there is */
+char* FAST_FUNC xmalloc_backup_name(const char *path, int control, const char *suffix)
+{
+	char *dir, *base;
+	DIR *d;
+	struct dirent *de;
+	unsigned long max = 0;
+	size_t blen;
+
+	if (control == BACKUP_NONE)
+		return NULL;
+	if (!suffix)
+		suffix = getenv("SIMPLE_BACKUP_SUFFIX");
+	if (!suffix || !*suffix || strchr(suffix, '/'))
+		suffix = "~";
+	if (control == BACKUP_SIMPLE)
+		return xasprintf("%s%s", path, suffix);
+	dir = xstrdup(path);
+	base = strrchr(dir, '/');
+	if (base) {
+		*base++ = '\0';
+		d = opendir(dir[0] ? dir : "/");
+	} else {
+		base = dir;
+		d = opendir(".");
+	}
+	blen = strlen(base);
+	while (d && (de = readdir(d)) != NULL) {
+		const char *p = de->d_name + blen;
+		char *end;
+		unsigned long n;
+		if (strncmp(de->d_name, base, blen) != 0 || p[0] != '.' || p[1] != '~' || !isdigit((unsigned char)p[2]))
+			continue;
+		n = strtoul(p + 2, &end, 10);
+		if (end[0] == '~' && !end[1] && n > max)
+			max = n;
+	}
+	if (d)
+		closedir(d);
+	free(dir);
+	if (control == BACKUP_EXISTING && max == 0)
+		return xasprintf("%s%s", path, suffix);
+	return xasprintf("%s.~%lu~", path, max + 1);
+}
