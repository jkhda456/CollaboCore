+/* GNU's --backup[=CONTROL] (cp, ln, mv, install): none/off, simple/never, numbered/t,
+ * existing/nil; without one, $VERSION_CONTROL, else existing */
+int FAST_FUNC xget_backup_control(const char *arg)
+{
+	static const char names[] ALIGN1 = "none\0off\0simple\0never\0existing\0nil\0numbered\0t\0";
+	static const unsigned char kinds[] = {
+		BACKUP_NONE, BACKUP_NONE, BACKUP_SIMPLE, BACKUP_SIMPLE,
+		BACKUP_EXISTING, BACKUP_EXISTING, BACKUP_NUMBERED, BACKUP_NUMBERED
+	};
+	int i;
+
+	if (!arg)
+		arg = getenv("VERSION_CONTROL");
+	if (!arg || !*arg)
+		return BACKUP_EXISTING;
+	i = index_in_substrings(names, arg);
+	if (i < 0)
+		bb_error_msg_and_die("invalid argument '%s' for 'backup type'", arg);
+	return kinds[i];
+}
