 /* This is a NOEXEC applet. Be very careful! */
 
+enum {
+	OPT_f = 1 << 0,
+	OPT_i = 1 << 1,
+	OPT_R = 1 << 2,
+	OPT_r = 1 << 3,
+	OPT_v = 1 << 4,
+	OPT_d = 1 << 5,
+	OPT_I = 1 << 6,
+	OPT_interactive = 1 << 7,
+	OPT_one_fs = 1 << 8,
+	OPT_no_preserve = 1 << 9,
+	OPT_preserve = 1 << 10,
+};
+
+/* how GNU rm names a file's type in its prompts */
+static const char *rm_type(const struct stat *st)
+{
+	switch (st->st_mode & S_IFMT) {
+	case S_IFREG: return st->st_size ? "regular file" : "regular empty file";
+	case S_IFDIR: return "directory";
+	case S_IFLNK: return "symbolic link";
+	case S_IFIFO: return "fifo";
+	case S_IFSOCK: return "socket";
+	case S_IFCHR: return "character special file";
+	case S_IFBLK: return "block special file";
+	}
+	return "file";
+}
+
+static int rm_ask(const char *fmt, const char *what, const char *path)
+{
+	fprintf(stderr, "%s: ", applet_name);
+	fprintf(stderr, fmt, what, path);
+	return bb_ask_y_confirmation();
+}
+
+/* would GNU ask before removing this one? (-i, or a write-protected file on a terminal) */
+static const char *rm_protected(const char *path, const struct stat *st, unsigned opt)
+{
+	if (opt & OPT_f)
+		return NULL;
+	if (!S_ISLNK(st->st_mode) && access(path, W_OK) != 0 && isatty(STDIN_FILENO))
+		return "write-protected ";
+	if (opt & OPT_i)
+		return "";
+	return NULL;
+}
+
+static int rm_path(const char *path, unsigned opt, dev_t top_dev, int depth)
+{
+	struct stat st;
+	const char *prot;
+
+	if (lstat(path, &st) != 0) {
+		if (errno == ENOENT && (opt & OPT_f))
+			return 0;
+		bb_perror_msg("cannot remove '%s'", path);
+		return -1;
+	}
+	prot = rm_protected(path, &st, opt);
+	if (S_ISDIR(st.st_mode)) {
+		DIR *dp;
+		struct dirent *de;
+		int status = 0, empty = 1;
+		char *ask;
+
+		if (!(opt & (OPT_r | OPT_R))) {
+			if (!(opt & OPT_d)) {
+				errno = EISDIR;
+				bb_perror_msg("cannot remove '%s'", path);
+				return -1;
+			}
+			if (prot) {
+				ask = xasprintf("remove %s%%s '%%s'? ", prot);
+				status = rm_ask(ask, "directory", path);
+				free(ask);
+				if (!status)
+					return 0;
+			}
+			goto remove_dir;
+		}
+		if ((opt & OPT_one_fs) && depth && st.st_dev != top_dev) {
+			bb_error_msg("skipping '%s', since it's on a different device", path);
+			return -1;
+		}
+		dp = opendir(path);
+		if (!dp) {
+			bb_perror_msg("cannot remove '%s'", path);
+			return -1;
+		}
+		while ((de = readdir(dp)) != NULL) {
+			if (!DOT_OR_DOTDOT(de->d_name)) {
+				empty = 0;
+				break;
+			}
+		}
+		if (prot && !empty) {
+			ask = xasprintf("descend into %s%%s '%%s'? ", prot);
+			status = rm_ask(ask, "directory", path);
+			free(ask);
+			if (!status) {
+				closedir(dp);
+				return 0;
+			}
+		}
+		rewinddir(dp);
+		while ((de = readdir(dp)) != NULL) {
+			char *sub = concat_subpath_file(path, de->d_name);
+			if (!sub)
+				continue;
+			if (rm_path(sub, opt, top_dev, depth + 1) < 0)
+				status = -1;
+			free(sub);
+		}
+		closedir(dp);
+		if (status < 0)
+			return status;
+		if (prot) {
+			ask = xasprintf("remove %s%%s '%%s'? ", prot);
+			status = rm_ask(ask, "directory", path);
+			free(ask);
+			if (!status)
+				return 0;
+		}
+ remove_dir:
+		if (rmdir(path) != 0) {
+			bb_perror_msg("cannot remove '%s'", path);
+			return -1;
+		}
+		if (opt & OPT_v)
+			printf("removed directory '%s'\n", path);
+		return 0;
+	}
+	if (prot) {
+		char *ask = xasprintf("remove %s%%s '%%s'? ", prot);
+		int yes = rm_ask(ask, rm_type(&st), path);
+		free(ask);
+		if (!yes)
+			return 0;
+	}
+	if (unlink(path) != 0) {
+		bb_perror_msg("cannot remove '%s'", path);
+		return -1;
+	}
+	if (opt & OPT_v)
+		printf("removed '%s'\n", path);
+	return 0;
+}
