diff --git a/coreutils/realpath.c b/coreutils/realpath.c
index 22820a7..e7a491c 100644
--- a/coreutils/realpath.c
+++ b/coreutils/realpath.c
@@ -21,32 +21,102 @@
 /* BB_AUDIT SUSv3 N/A -- Apparently a busybox extension. */
 
 //usage:#define realpath_trivial_usage
-//usage:       "FILE..."
+//usage:       "[-eLmPqsz] [--relative-to DIR] [--relative-base DIR] FILE..."
 //usage:#define realpath_full_usage "\n\n"
-//usage:       "Print absolute pathnames of FILEs"
+//usage:       "Print absolute pathnames of FILEs, as GNU realpath\n"
+//usage:     "\n	-e	All components must exist (default: all but the last)"
+//usage:     "\n	-m	No component needs to exist"
+//usage:     "\n	-L	Resolve .. before symlinks (-P: after, the default)"
+//usage:     "\n	-s	Don't expand symlinks (--strip, --no-symlinks)"
+//usage:     "\n	-q	No error messages"
+//usage:     "\n	-z	End each name with NUL"
+//usage:     "\n	--relative-to DIR	Print names relative to DIR"
+//usage:     "\n	--relative-base DIR	Relative names for those under DIR, else absolute"
 
 #include "libbb.h"
 
+/* is path under prefix (or prefix itself)? */
+static int path_prefix(const char *prefix, const char *path)
+{
+	size_t n = strlen(prefix);
+	if (strcmp(prefix, "/") == 0)
+		return 1;
+	return strncmp(path, prefix, n) == 0 && (path[n] == '\0' || path[n] == '/');
+}
+
 int realpath_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
 int realpath_main(int argc UNUSED_PARAM, char **argv)
 {
+	enum {
+		OPT_e = 1 << 0, OPT_L = 1 << 1, OPT_m = 1 << 2, OPT_P = 1 << 3,
+		OPT_q = 1 << 4, OPT_s = 1 << 5, OPT_z = 1 << 6,
+	};
+	static const char longopts[] ALIGN1 =
+		"canonicalize-existing\0" No_argument "e"
+		"logical\0"               No_argument "L"
+		"canonicalize-missing\0"  No_argument "m"
+		"physical\0"              No_argument "P"
+		"quiet\0"                 No_argument "q"
+		"strip\0"                 No_argument "s"
+		"no-symlinks\0"           No_argument "s"
+		"zero\0"                  No_argument "z"
+		"relative-to\0"           Required_argument "\xff"
+		"relative-base\0"         Required_argument "\xfe"
+	;
 	int retval = EXIT_SUCCESS;
+	char *rel_to = NULL, *rel_base = NULL, *can_to = NULL, *can_base = NULL;
+	unsigned opt, mode;
+
+	opt = getopt32long(argv, "^" "eLmPqsz\xff:\xfe:" "\0" "-1:e--m:m--e:L--P:P--L",
+			longopts, &rel_to, &rel_base);
+	argv += optind;
+	mode = (opt & OPT_e) ? CANON_EXISTING : (opt & OPT_m) ? CANON_MISSING : CANON_ALL_BUT_LAST;
+	if (opt & OPT_s)
+		mode |= CANON_NOLINKS;
+	if (opt & OPT_L)
+		mode |= CANON_LOGICAL;
+	if (opt & OPT_q)
+		logmode = LOGMODE_NONE;
 
-	if (!*++argv) {
-		bb_show_usage();
+	if (rel_base && !rel_to)
+		rel_to = rel_base;
+	if (rel_to) {
+		can_to = xmalloc_canonicalize(rel_to, mode);
+		if (!can_to)
+			bb_simple_perror_msg_and_die(rel_to);
+	}
+	if (rel_base) {
+		can_base = xmalloc_canonicalize(rel_base, mode);
+		if (!can_base)
+			bb_simple_perror_msg_and_die(rel_base);
+		/* as GNU: DIR out of the base, no name is relative */
+		if (!path_prefix(can_base, can_to)) {
+			free(can_to);
+			can_to = NULL;
+		}
 	}
 
 	do {
-		/* NOFORK: only one alloc is allowed; must free */
-		char *resolved_path = xmalloc_realpath_coreutils(*argv);
-		if (resolved_path != NULL) {
-			puts(resolved_path);
-			free(resolved_path);
+		/* NOFORK: must free what it allocates */
+		char *path = xmalloc_canonicalize(*argv, mode);
+		if (path) {
+			char *out = path;
+			if (can_to && (!can_base || path_prefix(can_base, path)))
+				out = xmalloc_relative_path(path, can_to);
+			fputs(out, stdout);
+			putchar((opt & OPT_z) ? '\0' : '\n');
+			if (out != path)
+				free(out);
+			free(path);
 		} else {
 			retval = EXIT_FAILURE;
 			bb_simple_perror_msg(*argv);
 		}
 	} while (*++argv);
 
+	if (ENABLE_FEATURE_CLEAN_UP) {
+		free(can_to);
+		free(can_base);
+	}
 	fflush_stdout_and_exit(retval);
 }
