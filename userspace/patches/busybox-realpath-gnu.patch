diff --git a/libbb/xreadlink.c b/libbb/xreadlink.c
index 2682f69..2a10aea 100644
--- a/libbb/xreadlink.c
+++ b/libbb/xreadlink.c
@@ -196,3 +196,186 @@ char* FAST_FUNC xmalloc_realpath_coreutils(char *path)
 
 	return buf;
 }
+
+/* GNU's canonicalize_filename_mode, for realpath and readlink -f -e -m. The kind (mode & 3):
+ * CANON_EXISTING: every component must exist; CANON_ALL_BUT_LAST: the last may be missing;
+ * CANON_MISSING: any may be. CANON_NOLINKS: symlinks are not followed, . and .. go as text;
+ * CANON_LOGICAL: .. goes first, as text, then symlinks are followed.
+ * NULL (and errno) if it can't be done. */
+static int more_components(const char *p)
+{
+	while (*p == '/')
+		p++;
+	return *p != '\0';
+}
+
+char* FAST_FUNC xmalloc_canonicalize(const char *name, unsigned mode)
+{
+	unsigned kind = mode & 3;
+	char *res, *pending, *p;
+	int links = 0, e;
+
+	if (!name[0]) {
+		errno = ENOENT;
+		return NULL;
+	}
+	/* res: the path so far, "" for "/" */
+	if (name[0] == '/') {
+		res = xzalloc(1);
+	} else {
+		res = xrealloc_getcwd_or_warn(NULL);
+		if (!res)
+			return NULL;
+		if (strcmp(res, "/") == 0)
+			res[0] = '\0';
+	}
+	pending = xstrdup(name);
+	if (mode & CANON_LOGICAL) {
+		/* "a/../b" is "b", whatever a is */
+		char *full = name[0] == '/' ? xstrdup(name) : xasprintf("%s/%s", res, name);
+		char *out = xzalloc(strlen(full) + 2), *q = full;
+		while (*q) {
+			size_t n;
+			while (*q == '/')
+				q++;
+			n = strcspn(q, "/");
+			if (n == 0)
+				break;
+			if (n == 2 && q[0] == '.' && q[1] == '.') {
+				char *s = strrchr(out, '/');
+				if (s)
+					*s = '\0';
+			} else if (!(n == 1 && q[0] == '.')) {
+				strcat(out, "/");
+				strncat(out, q, n);
+			}
+			q += n;
+		}
+		free(full);
+		free(pending);
+		pending = out[0] ? out : strcpy(xrealloc(out, 2), "/");
+		res[0] = '\0';
+	}
+	p = pending;
+	while (*p) {
+		struct stat st;
+		const char *comp;
+		size_t n;
+
+		while (*p == '/')
+			p++;
+		if (!*p)
+			break;
+		comp = p;
+		n = strcspn(p, "/");
+		p += n;
+		if (n == 1 && comp[0] == '.')
+			continue;
+		if (n == 2 && comp[0] == '.' && comp[1] == '.') {
+			char *s = strrchr(res, '/');
+			if (s)
+				*s = '\0';
+			continue;
+		}
+		res = xrealloc(res, strlen(res) + n + 2);
+		strcat(res, "/");
+		strncat(res, comp, n);
+		if (mode & CANON_NOLINKS) {
+			if (kind == CANON_EXISTING && stat(res, &st) != 0)
+				goto fail;
+			continue;
+		}
+		if (lstat(res, &st) != 0) {
+			if ((errno == ENOENT && kind == CANON_ALL_BUT_LAST && !more_components(p))
+			 || ((errno == ENOENT || errno == ENOTDIR) && kind == CANON_MISSING)
+			) {
+				continue;
+			}
+			goto fail;
+		}
+		if (S_ISLNK(st.st_mode)) {
+			char *target, *rest, *s;
+			if (++links > 40) {
+				errno = ELOOP;
+				goto fail;
+			}
+			target = xmalloc_readlink(res);
+			if (!target)
+				goto fail;
+			/* the link's target, then the rest */
+			rest = xasprintf("%s%s", target, p);
+			if (target[0] == '/') {
+				res[0] = '\0';
+			} else {
+				s = strrchr(res, '/');
+				*s = '\0';
+			}
+			free(target);
+			free(pending);
+			pending = p = rest;
+			continue;
+		}
+		if (!S_ISDIR(st.st_mode) && *p && kind != CANON_MISSING) {
+			/* "file/x", "file/" */
+			errno = ENOTDIR;
+			goto fail;
+		}
+	}
+	free(pending);
+	if (!res[0])
+		res = strcpy(xrealloc(res, 2), "/");
+	return res;
+ fail:
+	e = errno;
+	free(pending);
+	free(res);
+	errno = e;
+	return NULL;
+}
+
+/* path relative to dir, both canonical: "../c", "." */
+char* FAST_FUNC xmalloc_relative_path(const char *path, const char *dir)
+{
+	const char *p = path, *d = dir, *pc = path, *dc = dir;
+	char *out;
+	size_t ups = 0;
+
+	/* the common leading components */
+	for (;;) {
+		size_t pn, dn;
+		while (*p == '/')
+			p++;
+		while (*d == '/')
+			d++;
+		pn = strcspn(p, "/");
+		dn = strcspn(d, "/");
+		if (!pn || pn != dn || strncmp(p, d, pn) != 0)
+			break;
+		p += pn;
+		d += dn;
+		pc = p;
+		dc = d;
+	}
+	for (d = dc; *d; ) {
+		size_t dn;
+		while (*d == '/')
+			d++;
+		dn = strcspn(d, "/");
+		if (dn)
+			ups++;
+		d += dn;
+	}
+	while (*pc == '/')
+		pc++;
+	out = xzalloc(ups * 3 + strlen(pc) + 2);
+	while (ups--)
+		strcat(out, out[0] ? "/.." : "..");
+	if (*pc) {
+		if (out[0])
+			strcat(out, "/");
+		strcat(out, pc);
+	}
+	if (!out[0])
+		strcpy(out, ".");
+	return out;
+}
diff --git a/include/libbb.h b/include/libbb.h
index 858ac35..bd823fd 100644
--- a/include/libbb.h
+++ b/include/libbb.h
@@ -593,6 +593,9 @@ DIR *warn_opendir(const char *path) FAST_FUNC;
 
 char *xmalloc_realpath(const char *path) FAST_FUNC RETURNS_MALLOC;
 char *xmalloc_realpath_coreutils(char *path) FAST_FUNC RETURNS_MALLOC;
+enum { CANON_EXISTING = 0, CANON_ALL_BUT_LAST = 1, CANON_MISSING = 2, CANON_NOLINKS = 4, CANON_LOGICAL = 8 };
+char *xmalloc_canonicalize(const char *name, unsigned mode) FAST_FUNC RETURNS_MALLOC;
+char *xmalloc_relative_path(const char *path, const char *dir) FAST_FUNC RETURNS_MALLOC;
 char *xmalloc_readlink(const char *path) FAST_FUNC RETURNS_MALLOC;
 char *xmalloc_readlink_or_warn(const char *path) FAST_FUNC RETURNS_MALLOC;
