+static void send_sig(pid_t pid, int sig, int foreground, int verbose, const char *prog)
+{
+	if (verbose)
+		bb_error_msg("sending signal %s to command '%s'", get_signame(sig), prog);
+	kill(pid, sig);
+	if (!foreground) {
+		kill(0, sig);
+		if (sig != SIGKILL && sig != SIGSTOP) {
+			/* our own copy is blocked: take it back so it is not seen as one from outside */
+			sigset_t one;
+			struct timespec zero = { 0, 0 };
+			sigemptyset(&one);
+			sigaddset(&one, sig);
+			sigtimedwait(&one, NULL, &zero);
+		}
+	}
+	if (sig != SIGKILL && sig != SIGCONT) {
+		/* a stopped process would not see it */
+		kill(pid, SIGCONT);
+		if (!foreground)
+			kill(0, SIGCONT);
 	}
