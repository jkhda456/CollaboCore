+/* 'l': \\, \a \b \f \n \r \t \v, other unprintable bytes as \ooo, a $ at the end;
+ * lines longer than LEN-1 characters wrap with a \ (LEN 0: never) */
+static void do_list(const char *s, int len)
+{
+	static const char esc[] ALIGN1 = "\a\b\f\n\r\t\v";
+	FILE *fp = G.nonstdout;
+	int width = 0;
+
+	for (; *s; s++) {
+		char obuf[8];
+		int w;
+		unsigned char c = *s;
+		const char *e = strchr(esc, c);
+
+		if (c == '\\')
+			w = sprintf(obuf, "\\\\");
+		else if (c >= 0x20 && c < 0x7f)
+			w = sprintf(obuf, "%c", c);
+		else if (e)
+			w = sprintf(obuf, "\\%c", "abfnrtv"[e - esc]);
+		else
+			w = sprintf(obuf, "\\%03o", c);
+		if (len > 0 && width + w > len - 1) {
+			fputs("\\\n", fp);
+			width = 0;
+		}
+		fputs(obuf, fp);
+		width += w;
+	}
+	fputs("$\n", fp);
+}
