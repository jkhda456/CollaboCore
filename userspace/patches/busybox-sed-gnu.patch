+/* GNU's case conversion in the replacement: \U, \L until \E (or the other one),
+ * \u, \l for the next character only */
+static void pipe_putc_case(char c, char mode, char *once)
+{
+	if (*once) {
+		c = (*once == 'u') ? toupper((unsigned char)c) : tolower((unsigned char)c);
+		*once = 0;
+	} else if (mode == 'U')
+		c = toupper((unsigned char)c);
+	else if (mode == 'L')
+		c = tolower((unsigned char)c);
+	pipe_putc(c);
+}
