+/* "a,b", or "b" for one line or none (where an insertion goes) */
+static void print_normal_range(int a, int b)
+{
+	if (a < b)
+		printf("%d,%d", a, b);
+	else
+		printf("%d", b);
+}
+
+/* The normal format, GNU diff's default: each change as "2c2", "3a4,5" or "6,7d5",
+ * the old lines as "< ", "---", the new ones as "> " */
+static void print_normal_hunk(FILE_and_pos_t ft[2], off_t *ix[2], vec_t *vec, int idx)
+{
+	int k;
+	for (k = 0; k <= idx; k++) {
+		int del = vec[k][0].a <= vec[k][0].b;
+		int add = vec[k][1].a <= vec[k][1].b;
+		print_normal_range(vec[k][0].a, vec[k][0].b);
+		putchar(del ? (add ? 'c' : 'd') : 'a');
+		print_normal_range(vec[k][1].a, vec[k][1].b);
+		putchar('\n');
+		fetch(&ft[0], ix[0], vec[k][0].a, vec[k][0].b, '<');
+		if (del && add)
+			puts("---");
+		fetch(&ft[1], ix[1], vec[k][1].a, vec[k][1].b, '>');
+	}
+}
