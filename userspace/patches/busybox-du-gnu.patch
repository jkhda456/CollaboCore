+/* coreutils' human_readable, rounding up: one decimal under 10, "1.0M" rather than "1024K" */
+static void du_human(char *buf, unsigned long long n, unsigned base)
+{
+	static const char sfx_1024[] ALIGN1 = "KMGTPEZY";
+	static const char sfx_1000[] ALIGN1 = "kMGTPEZY";
+	const char *sfx = base == 1000 ? sfx_1000 : sfx_1024;
+	unsigned long long p = 1, q, r;
+	int e = 0;
+
+	while (n / p >= base && e < 8) {
+		p *= base;
+		e++;
+	}
+	if (e == 0) {
+		sprintf(buf, "%llu", n);
+		return;
+	}
+	q = n / p;
+	r = n % p;
+	if (q < 10) {
+		unsigned long long t = (r * 10 + p - 1) / p; /* tenths, rounded up */
+		if (t == 10) {
+			q++;
+			t = 0;
+		}
+		if (q < 10) {
+			sprintf(buf, "%llu.%llu%c", q, t, sfx[e - 1]);
+			return;
+		}
+	} else if (r) {
+		q++;
+	}
+	if (q == base && e < 8) {
+		sprintf(buf, "1.0%c", sfx[e]);
+		return;
+	}
+	sprintf(buf, "%llu%c", q, sfx[e - 1]);
+}
+
+/* SIZE for -B and -t: N[K|M|G][iB|B] or the suffix alone; KB is 1000 */
+static unsigned long long du_size(const char *arg, const char *opt, const char **suffix)
+{
+	static const struct suffix_mult sizes[] ALIGN_SUFFIX = {
+		{ "KiB", 1024ULL }, { "KB", 1000ULL }, { "K", 1024ULL }, { "k", 1024ULL },
+		{ "MiB", 1024ULL * 1024 }, { "MB", 1000ULL * 1000 }, { "M", 1024ULL * 1024 },
+		{ "GiB", 1024ULL * 1024 * 1024 }, { "GB", 1000ULL * 1000 * 1000 }, { "G", 1024ULL * 1024 * 1024 },
+		{ "", 0 }
+	};
+	unsigned long long n;
+	char *num = (char*)arg;
+
+	if (suffix)
+		*suffix = isdigit((unsigned char)arg[0]) ? "" : arg;
+	if (!isdigit((unsigned char)arg[0]))
+		num = xasprintf("1%s", arg);
+	n = xatoull_sfx(num, sizes);
+	if (num != arg)
+		free(num);
+	if (n == 0)
+		bb_error_msg_and_die("invalid %s argument '%s'", opt, arg);
+	return n;
+}
 
