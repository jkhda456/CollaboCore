+/* One open file of a process; returns 1 when it was listed */
+static int one_file(pid_t pid, const char *cmd, const char *user, int proc_selected,
+		const char *fdname, const char *linkpath, int fdnum)
+{
+	struct stat st;
+	int have_st = (stat(linkpath, &st) == 0);
+	/* "mem" passes the mapped file itself, the others a /proc link */
+	char *target = (fdnum == -2) ? xstrdup(linkpath) : xmalloc_readlink(linkpath);
+	char *fd, *type, *device, *sizeoff, *node, *name;
+	char mode = ' ';
+	int is_inet = 0, is_unix = 0, sel;
+	struct inet *in = NULL;
+	struct usock *us = NULL;
+	unsigned long sockino = 0;
