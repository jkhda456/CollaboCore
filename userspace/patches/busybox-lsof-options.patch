+static void parse_hex_addr(const char *s, unsigned char *out, int af)
+{
+	int words = (af == 4) ? 1 : 4, w, b;
+	for (w = 0; w < words; w++) {
+		uint32_t v = 0;
+		for (b = 0; b < 8 && s[w * 8 + b]; b++) {
+			int c = s[w * 8 + b];
+			v = v * 16 + (isdigit(c) ? c - '0' : (tolower(c) - 'a' + 10));
+		}
+		/* each 32-bit word is in host (little endian) order */
+		memcpy(out + w * 4, &v, 4);
+	}
+}
+
+static void read_inet(const char *file, int af, int proto)
+{
+	FILE *fp = fopen_for_read(file);
+	char *line;
+
+	if (!fp)
+		return;
+	free(xmalloc_fgetline(fp)); /* header */
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		char la[40], ra[40];
+		unsigned lp, rp, st;
+		unsigned long ino;
+		/* sl local rem st tx:rx tr:when retr uid timeout inode */
+		if (sscanf(line, "%*s %39[0-9A-Fa-f]:%x %39[0-9A-Fa-f]:%x %x %*s %*s %*s %*s %*s %lu",
+				la, &lp, ra, &rp, &st, &ino) == 6 && ino) {
+			struct inet *n;
+			G.inets = xrealloc_vector(G.inets, 6, G.ninets);
+			n = &G.inets[G.ninets++];
+			memset(n, 0, sizeof(*n));
+			n->ino = ino;
+			n->af = af;
+			n->proto = proto;
+			n->state = st;
+			n->lport = lp;
+			n->rport = rp;
+			parse_hex_addr(la, n->laddr, af);
+			parse_hex_addr(ra, n->raddr, af);
+		}
+		free(line);
+	}
+	fclose(fp);
+}
