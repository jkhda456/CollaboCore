+static char *inet_name(const struct inet *n)
+{
+	char *l, *lp, *res;
+
+	l = is_any(n->laddr, n->af) ? xstrdup("*") : addr_str(n->laddr, n->af);
+	lp = n->lport ? port_str(n->lport, n->proto) : xstrdup("*");
+	if (n->rport || !is_any(n->raddr, n->af)) {
+		char *r = addr_str(n->raddr, n->af);
+		char *rp = port_str(n->rport, n->proto);
+		res = xasprintf("%s:%s->%s:%s", l, lp, r, rp);
+		free(r);
+		free(rp);
+	} else
+		res = xasprintf("%s:%s", l, lp);
+	if (n->proto == 't' && n->state < ARRAY_SIZE(tcp_state_names)) {
+		char *t = xasprintf("%s (%s)", res, tcp_state_names[n->state]);
+		free(res);
+		res = t;
+	} else if (n->proto == 'u') {
+		/* lsof leaves the (empty) state after a space */
+		char *t = xasprintf("%s ", res);
+		free(res);
+		res = t;
+	}
+	free(l);
+	free(lp);
+	return res;
+}
