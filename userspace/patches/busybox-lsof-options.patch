+	/* mem: the files mapped in, but for the program itself */
+	sprintf(path, "/proc/%u/exe", (unsigned)pid);
+	exe = xmalloc_readlink(path);
+	sprintf(path, "/proc/%u/maps", (unsigned)pid);
+	maps = fopen_for_read(path);
+	if (maps) {
+		char *line;
+		while ((line = xmalloc_fgetline(maps)) != NULL) {
+			unsigned long ino = 0;
+			int n = 0;
+			sscanf(line, "%*s %*s %*s %*s %lu %n", &ino, &n);
+			if (ino && n && line[n] == '/' && !strstr(line + n, " (deleted)")
+			 && (!exe || strcmp(line + n, exe) != 0)
