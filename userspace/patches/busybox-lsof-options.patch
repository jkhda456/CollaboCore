+	cmd = xmalloc_open_read_close(path, NULL);
+	if (!cmd)
+		return;
+	*strchrnul(cmd, '\n') = '\0';
+	user = G.numeric_uid ? xasprintf("%u", (unsigned)pst.st_uid) : xstrdup(uid2uname_utoa(pst.st_uid));
+
+	/* ^PID, ^USER, ^NAME leave a process out in any case */
+	{
+		char *uid = xasprintf("%u", (unsigned)pst.st_uid);
+		int out = llist_find_str(G.xpids, utoa(pid)) || llist_find_str(G.xusers, user)
+			|| llist_find_str(G.xusers, uid) || has_prefix_of(G.xcmds, cmd);
+		int any = 0, all = 1;
+		if (!out && (G.selections & (SEL_P | SEL_U | SEL_C))) {
+			/* the process selections: -p -u -c */
+			if (G.pids) {
+				if (llist_find_str(G.pids, utoa(pid))) any = 1; else all = 0;
+			}
+			if (G.users) {
+				if (llist_find_str(G.users, user) || llist_find_str(G.users, uid)) any = 1; else all = 0;
+			}
+			if (G.cmds) {
+				if (has_prefix_of(G.cmds, cmd)) any = 1; else all = 0;
+			}
+			/* -a: all of them; else any (files may still pick one in this process) */
