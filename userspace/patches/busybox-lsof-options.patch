+		FILE *fp = fopen_for_read(info);
+		free(info);
+		if (fp) {
+			char *line;
+			while ((line = xmalloc_fgetline(fp)) != NULL) {
+				unsigned long flags;
+				if (sscanf(line, "flags: %lo", &flags) == 1)
+					mode = "rwu"[MIN(flags & O_ACCMODE, 2u)];
+				sscanf(line, "pos: %llu", &pos);
+				free(line);
+			}
+			fclose(fp);
+		}
+	}
+	if (sscanf(target, "socket:[%lu]", &sockino) == 1) {
+		in = find_inet(sockino);
+		if (in)
+			is_inet = 1;
+		else if ((us = find_unix(sockino)) != NULL)
+			is_unix = 1;
+	}
+
+	/* is it selected? */
+	if (G.selections) {
+		int file_sel = (G.selections & (SEL_I | SEL_F | SEL_X))
+			? ((is_inet && G.sel_i && inet_selected(in))
+			   || (is_unix && G.sel_U)
+			   || ((G.selections & SEL_F) && file_selected(have_st ? &st : NULL, target)))
+			: -1;
+		if (G.and_mode)
+			sel = proc_selected && file_sel != 0;
+		else
+			sel = proc_selected > 0 || file_sel > 0;
+		if (!sel) {
+			free(target);
+			return 0;
+		}
+	}
+
+	fd = (fdnum >= 0) ? xasprintf("%d%c", fdnum, mode) : xstrdup(fdname);
+	if (is_inet) {
+		type = xstrdup(in->af == 4 ? "IPv4" : "IPv6");
+		device = xasprintf("%lu", sockino);
+		sizeoff = xasprintf("0t%llu", pos);
+		node = xstrdup(in->proto == 't' ? "TCP" : "UDP");
+		name = inet_name(in);
+	} else if (is_unix) {
+		static const char *const utypes[] = { "", "STREAM", "DGRAM", "RAW", "RDM", "SEQPACKET" };
+		type = xstrdup("unix");
+		device = xstrdup(us->addr);
+		sizeoff = xasprintf("0t%llu", pos);
+		node = xasprintf("%lu", sockino);
+		name = xasprintf("%s%stype=%s%s", us->path ? us->path : "", us->path ? " " : "",
+			us->type < ARRAY_SIZE(utypes) ? utypes[us->type] : "?",
+			(us->flags & 0x10000) ? " (LISTEN)" : us->state == 3 ? " (CONNECTED)" : "");
+	} else if (sockino) {
+		type = xstrdup("sock");
+		device = have_st ? dev_str(st.st_dev) : xstrdup("0,0");
+		sizeoff = xasprintf("0t%llu", pos);
+		node = xasprintf("%lu", sockino);
+		name = xstrdup("protocol: unknown");
+	} else if (strncmp(target, "pipe:", 5) == 0) {
+		type = xstrdup("FIFO");
+		device = have_st ? dev_str(st.st_dev) : xstrdup("0,0");
+		sizeoff = xasprintf("0t%llu", pos);
+		node = have_st ? xasprintf("%lu", (unsigned long)st.st_ino) : xstrdup("0");
+		name = xstrdup("pipe");
+	} else if (strncmp(target, "anon_inode:", 11) == 0) {
+		type = xstrdup("a_inode");
+		device = have_st ? dev_str(st.st_dev) : xstrdup("0,0");
+		sizeoff = xstrdup("0");
+		node = have_st ? xasprintf("%lu", (unsigned long)st.st_ino) : xstrdup("0");
+		name = xstrdup(target + 11);
+	} else {
+		type = xstrdup(have_st ? type_of(st.st_mode) : "unknown");
+		if (have_st && (S_ISCHR(st.st_mode) || S_ISBLK(st.st_mode))) {
+			device = dev_str(st.st_rdev);
+			sizeoff = xasprintf("0t%llu", pos);
+		} else {
+			device = have_st ? dev_str(st.st_dev) : xstrdup("");
+			sizeoff = have_st ? (S_ISFIFO(st.st_mode)
+					? xasprintf("0t%llu", pos)
+					: xasprintf("%llu", (unsigned long long)st.st_size))
+				: xstrdup("");
+		}
+		node = have_st ? xasprintf("%lu", (unsigned long)st.st_ino) : xstrdup("");
+		name = xstrdup(target);
+	}
+	free(target);
+	add_row(pid, cmd, user, fd, type, device, sizeoff, node, name);
+	return 1;
+}
