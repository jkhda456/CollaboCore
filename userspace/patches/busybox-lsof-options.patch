+/* ---- selections */
+
+static int parse_ispec(const char *s, struct ispec *is)
+{
+	memset(is, 0, sizeof(*is));
+	if (*s == '4' || *s == '6')
+		is->af = *s++ - '0';
+	if (strncasecmp(s, "tcp", 3) == 0) {
+		is->proto = 't';
+		s += 3;
+	} else if (strncasecmp(s, "udp", 3) == 0) {
+		is->proto = 'u';
+		s += 3;
+	}
+	if (*s == '@') {
+		char host[256];
+		const char *e;
+		s++;
+		if (*s == '[') {
+			e = strchr(s, ']');
+			if (!e)
+				return 0;
+			safe_strncpy(host, s + 1, MIN((size_t)(e - s), sizeof(host)));
+			s = e + 1;
+		} else {
+			e = strchrnul(s, ':');
+			safe_strncpy(host, s, MIN((size_t)(e - s) + 1, sizeof(host)));
+			s = e;
+		}
+		if (inet_pton(AF_INET, host, is->host) == 1)
+			is->hostaf = 4;
+		else if (inet_pton(AF_INET6, host, is->host) == 1)
+			is->hostaf = 6;
+		else {
+			/* a name: /etc/hosts, then the resolver */
+			struct addrinfo hints, *ai = NULL;
+			memset(&hints, 0, sizeof(hints));
+			hints.ai_family = is->af == 4 ? AF_INET : is->af == 6 ? AF_INET6 : AF_UNSPEC;
+			if (getaddrinfo(host, NULL, &hints, &ai) != 0 || !ai)
+				return 0;
+			if (ai->ai_family == AF_INET) {
+				memcpy(is->host, &((struct sockaddr_in *)ai->ai_addr)->sin_addr, 4);
+				is->hostaf = 4;
+			} else {
+				memcpy(is->host, &((struct sockaddr_in6 *)ai->ai_addr)->sin6_addr, 16);
+				is->hostaf = 6;
+			}
+			freeaddrinfo(ai);
+		}
+		is->has_host = 1;
+	}
+	if (*s == ':') {
+		s++;
+		while (*s) {
+			char *end;
+			unsigned lo, hi;
+			if (isdigit(*s)) {
+				lo = hi = strtoul(s, &end, 10);
+				if (*end == '-' && isdigit(end[1]))
+					hi = strtoul(end + 1, &end, 10);
+			} else {
+				char name[64];
+				struct servent *se;
+				size_t len = strcspn(s, ",");
+				safe_strncpy(name, s, MIN(len + 1, sizeof(name)));
+				se = getservbyname(name, is->proto == 'u' ? "udp" : "tcp");
+				if (!se)
+					return 0;
+				lo = hi = ntohs(se->s_port);
+				end = (char *)s + len;
+			}
+			is->plo = xrealloc_vector(is->plo, 3, is->nports);
+			is->phi = xrealloc_vector(is->phi, 3, is->nports);
+			is->plo[is->nports] = lo;
+			is->phi[is->nports++] = hi;
+			s = end;
+			if (*s == ',')
+				s++;
+			else if (*s)
+				return 0;
+		}
+	}
+	return *s == '\0';
+}
