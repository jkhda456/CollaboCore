+static void read_unix(void)
+{
+	FILE *fp = fopen_for_read("/proc/net/unix");
+	char *line;
+
+	if (!fp)
+		return;
+	free(xmalloc_fgetline(fp));
+	while ((line = xmalloc_fgetline(fp)) != NULL) {
+		char addr[40];
+		unsigned flags, type, st;
+		unsigned long ino;
+		int n = 0;
+		/* Num RefCount Protocol Flags Type St Inode Path */
+		if (sscanf(line, "%39[0-9A-Fa-f]: %*s %*s %x %x %x %lu %n",
+				addr, &flags, &type, &st, &ino, &n) >= 5) {
+			struct usock *u;
+			G.usocks = xrealloc_vector(G.usocks, 6, G.nusocks);
+			u = &G.usocks[G.nusocks++];
+			u->ino = ino;
+			u->type = type;
+			u->state = st;
+			u->flags = flags;
+			u->addr = xasprintf("0x%s", addr);
+			u->path = (n && line[n]) ? xstrdup(line + n) : NULL;
+		}
+		free(line);
+	}
+	fclose(fp);
+}
