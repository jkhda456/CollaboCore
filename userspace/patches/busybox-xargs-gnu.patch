+			else if (w[0] == '-' && w[1] != '-') {
+				for (w++; *w; w++) {
+					if (*w == 'n') { last = 'n'; break; }
+					if (*w == 'L' || *w == 'l') { last = *w; break; }
+					if (strchr("seEIiPad", *w)) break; /* the rest is its argument */
+				}
+			}
+		}
+		if (last == 'n') {
+			bb_simple_error_msg("warning: options --max-lines and --max-args/-n are mutually exclusive, ignoring previous --max-lines value");
+			opt &= ~(OPT_MAX_LINES | OPT_MAX_LINES1);
