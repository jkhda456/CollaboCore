+/* -L N: the words of N nonblank lines (a line ending in a blank goes on into the next one) */
+static char* FAST_FUNC process_lines_stdin(int n_max_chars, int n_max_arg, char *buf)
+{
+	char *s = buf;             /* start of the word */
+	char *p = s + strlen(buf); /* end of the word */
+	int lines = 0, words = 0, last_blank = 0, quote = 0, backslash = 0;
+
+	buf += n_max_chars;        /* past buffer's end */
+
+	while (1) {
+		int c = getchar();
+		int end_word = 0;
+
+		if (c == EOF) {
+			if (quote)
+				bb_error_msg_and_die("unmatched %s quote", quote == '\'' ? "single" : "double");
+			end_word = 1;
+		} else if (backslash) {
+			backslash = 0;
+			last_blank = 0;
+			*p++ = c;
+		} else if (quote) {
+			last_blank = 0;
+			if (c == quote)
+				quote = 0;
+			else
+				*p++ = c;
+		} else if (c == '\n') {
+			end_word = 1;
+		} else if (ISSPACE(c)) {
+			end_word = 1;
+			last_blank = 1;
+		} else {
+			last_blank = 0;
+			if (c == '\\')
+				backslash = 1;
+			else if (c == '\'' || c == '"')
+				quote = c;
+			else
+				*p++ = c;
+		}
+		if (end_word && p != s) {
+			*p++ = '\0';
+			if (G.eof_str && strcmp(s, G.eof_str) == 0) {
+				while (getchar() != EOF)
+					continue;
+				p = s;
+				goto ret;
+			}
+			store_param(s);
+			s = p;
+			words++;
+			if (--n_max_arg == 0)
+				goto ret;
+		}
+		if (c == EOF)
+			goto ret;
+		if (c == '\n') {
+			/* a line ending in a blank goes on */
+			if (words && !last_blank) {
+				words = 0;
+				if (++lines >= G.max_lines)
+					goto ret;
+			}
+			last_blank = 0;
+		}
+		if (p == buf)
+			goto ret;
+	}
+ ret:
+	*p = '\0';
+	return s;
+}
 
