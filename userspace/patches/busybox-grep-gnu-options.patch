+/* Does GLOB match NAME, as GNU grep matches --include, --exclude and --exclude-dir: a name met
+ * in a directory by its last component, one from the command line by any suffix of it that
+ * starts after a slash ("../d" is "d" too; "sub/" is not "sub") */
+static int name_matches(const char *glob, const char *name, int command_line)
+{
+	if (!command_line)
+		return fnmatch(glob, bb_basename(name), 0) == 0;
+	for (;;) {
+		if (fnmatch(glob, name, 0) == 0)
+			return 1;
+		name = strchr(name, '/');
+		if (!name)
+			return 0;
+		while (*name == '/')
+			name++;
+		if (!*name)
+			return 0;
+	}
+}
+
+/* --include, --exclude: the last rule whose GLOB matches decides */
+static int skip_file(const char *name, int command_line)
+{
+	const struct name_rule *rule, *last = NULL;
+	int i;
+
+	if (!G.name_rule_count)
+		return 0;
+	for (i = 0; i < G.name_rule_count; i++) {
+		rule = &G.name_rules[i];
+		if ((!last || rule->pos > last->pos) && name_matches(rule->glob, name, command_line))
+			last = rule;
+	}
+	return last ? last->skip : G.name_default_skip;
+}
+
+/* --exclude-dir */
+static int skip_dir(const char *name, int command_line)
+{
+	llist_t *l;
+
+	for (l = G.exclude_dirs; l; l = l->link)
+		if (name_matches(l->data, name, command_line))
+			return 1;
+	return 0;
+}
+
+/* Which argv string holds S, an option's argument ("--include=GLOB" or "--include GLOB"): where
+ * the option stands. getopt moves operands after the options but keeps the options' order. */
+static int argv_position(char **argv, const char *s)
+{
+	int i;
+
+	for (i = 0; argv[i]; i++)
+		if (s >= argv[i] && s <= argv[i] + strlen(argv[i]))
+			return i;
+	return 0;
+}
+
+static void add_name_rules(char **argv, llist_t *globs, int skip)
+{
+	for (; globs; globs = globs->link) {
+		struct name_rule *rule;
+
+		G.name_rules = xrealloc_vector(G.name_rules, 3, G.name_rule_count);
+		rule = &G.name_rules[G.name_rule_count++];
+		rule->glob = globs->data;
+		rule->pos = argv_position(argv, globs->data);
+		rule->skip = skip;
+	}
+}
