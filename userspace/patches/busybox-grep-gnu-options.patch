+/* -I: a binary file, as GNU grep tells one in the C locale: a NUL byte in what it reads first
+ * (96 KiB). Read from where the file stands without moving it; only regular files, as a pipe
+ * cannot be read twice. */
+static int binary_file(FILE *file)
+{
+	enum { LOOK = 96 * 1024 };
+	struct stat st;
+	char *buf;
+	off_t at;
+	ssize_t n;
+	int binary;
+
+	if (fstat(fileno(file), &st) != 0 || !S_ISREG(st.st_mode))
+		return 0;
+	at = lseek(fileno(file), 0, SEEK_CUR);
+	if (at < 0)
+		return 0;
+	buf = xmalloc(LOOK);
+	n = pread(fileno(file), buf, LOOK, at);
+	binary = n > 0 && memchr(buf, '\0', n) != NULL;
+	free(buf);
+	return binary;
+}
