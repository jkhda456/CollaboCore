wasm32: dlopen through the collaboCore engine (side modules), and floating-point flags in software

dlopen, dlsym and the rest for WebAssembly side modules (wasm-ld -shared --experimental-pic):
src/ldso/wasm32/dlopen.c reads the library, allocates its memory and asks the engine to
compile, link and instantiate it (dylink calls: syscalls 0x7d000000 and up, which the engine
answers and a host without them leaves to the kernel's ENOSYS); every other thread instantiates
it too before it runs any of its code (__dl_sync: at thread start, and when it takes a mutex). And
fenv: WebAssembly has no exception flags, so feraiseexcept/fetestexcept keep them per thread
in software (what a program raises itself, it sees again). And the library built with default
visibility, which musl's own hidden attributes narrow to its interface: what -rdynamic exports.


diff --git a/arch/wasm32/arch.mak b/arch/wasm32/arch.mak
index 52e2267..03aea5a 100644
--- a/arch/wasm32/arch.mak
+++ b/arch/wasm32/arch.mak
@@ -1,5 +1,9 @@
 CC = clang
 CFLAGS += --target=wasm32 -matomics -mbulk-memory
+# clang's WebAssembly target makes symbols hidden by default; musl marks its internals hidden
+# itself, so with default visibility a program linked to load libraries (-rdynamic, which exports
+# what is not hidden) exports the C library's interface and nothing else.
+CFLAGS += -fvisibility=default
 LDFLAGS =
 CROSS_COMPILE = llvm-
 LIBCC =
diff --git a/arch/wasm32/bits/fenv.h b/arch/wasm32/bits/fenv.h
new file mode 100644
index 0000000..526e7da
--- /dev/null
+++ b/arch/wasm32/bits/fenv.h
@@ -0,0 +1,21 @@
+/* WebAssembly has no floating-point exception flags, and rounds to nearest only. The flags
+ * here are kept in software (src/fenv/wasm32/fenv.c), per thread: what feraiseexcept raises,
+ * fetestexcept sees (a library's own checks: numpy's singular matrices, its integer division
+ * by zero); the operations themselves raise none. */
+#define FE_INVALID    1
+#define FE_DIVBYZERO  4
+#define FE_OVERFLOW   8
+#define FE_UNDERFLOW  16
+#define FE_INEXACT    32
+
+#define FE_ALL_EXCEPT 61
+
+#define FE_TONEAREST  0
+
+typedef unsigned short fexcept_t;
+
+typedef struct {
+	unsigned short __flags;
+} fenv_t;
+
+#define FE_DFL_ENV      ((const fenv_t *) -1)
diff --git a/src/fenv/wasm32/fenv.c b/src/fenv/wasm32/fenv.c
new file mode 100644
index 0000000..5cf565a
--- /dev/null
+++ b/src/fenv/wasm32/fenv.c
@@ -0,0 +1,45 @@
+#include <fenv.h>
+
+/* The exception flags in software (arch/wasm32/bits/fenv.h): WebAssembly's operations raise
+ * none, so these are what feraiseexcept raised, kept per thread as C has them. One copy for
+ * the whole program, the dynamically loaded modules included: they all call these. */
+static _Thread_local unsigned short flags;
+
+int feclearexcept(int mask)
+{
+	flags &= ~(mask & FE_ALL_EXCEPT);
+	return 0;
+}
+
+int feraiseexcept(int mask)
+{
+	flags |= mask & FE_ALL_EXCEPT;
+	return 0;
+}
+
+int fetestexcept(int mask)
+{
+	return flags & mask & FE_ALL_EXCEPT;
+}
+
+int fegetround(void)
+{
+	return FE_TONEAREST;
+}
+
+int __fesetround(int r)
+{
+	return 0;
+}
+
+int fegetenv(fenv_t *envp)
+{
+	envp->__flags = flags;
+	return 0;
+}
+
+int fesetenv(const fenv_t *envp)
+{
+	flags = envp == FE_DFL_ENV ? 0 : envp->__flags;
+	return 0;
+}
