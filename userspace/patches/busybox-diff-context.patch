+typedef struct { int a, b; } vec_t[2];
+
+/* A range of the context format's hunk header: "a,b", or the last line alone ("b") when the
+ * range has one line or none, as GNU diff prints it */
+static void print_context_range(const char *mark, int a, int b, const char *end)
+{
+	if (b <= a)
+		printf("%s %d %s\n", mark, b, end);
+	else
+		printf("%s %d,%d %s\n", mark, a, b, end);
+}
+
+/* One hunk in the context format (-c, -C): the changes vec[0..idx] with their context, the
+ * old file's lines ("- " deleted, "! " changed) and then the new file's ("+ " added, "! "
+ * changed); a side none of the changes has lines on is its header alone. */
+static void print_context_hunk(FILE_and_pos_t ft[2], off_t *ix[2], const int nlen[2],
+		vec_t *vec, int idx)
+{
+	int j, k, low;
+	int span_a[2], span_b[2];
+
+	puts("***************");
+	for (j = 0; j < 2; j++) {
+		span_a[j] = MAX(1, vec[0][j].a - opt_U_context);
+		span_b[j] = MIN(nlen[j], vec[idx][j].b + opt_U_context);
+	}
+	for (j = 0; j < 2; j++) {
+		bool lines = false;
+		print_context_range(j ? "---" : "***", span_a[j], span_b[j], j ? "----" : "****");
+		for (k = 0; k <= idx; k++)
+			lines |= vec[k][j].a <= vec[k][j].b;
+		if (!lines)
+			continue;
+		low = span_a[j];
+		for (k = 0; k <= idx; k++) {
+			bool both = vec[k][0].a <= vec[k][0].b && vec[k][1].a <= vec[k][1].b;
+			fetch(&ft[j], ix[j], low, vec[k][j].a - 1, ' ');
+			fetch(&ft[j], ix[j], vec[k][j].a, vec[k][j].b, both ? '!' : j ? '+' : '-');
+			low = vec[k][j].b + 1;
+		}
+		fetch(&ft[j], ix[j], low, span_b[j], ' ');
+	}
+}
+
