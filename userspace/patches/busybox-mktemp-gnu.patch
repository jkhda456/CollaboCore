 		"dry-run\0"   No_argument       "u"
 		"tmpdir\0"    Optional_argument "\xff"
-		, &path, &path
+		"suffix\0"    Required_argument "\xfe"
+		, &dir, &dir, &suffix
 	);
-#else
-	opts = getopt32(argv, "^" "dqtp:u" "\0" "?1"/*1 arg max*/, &path);
-#endif
+	if (opts & OPT_q)
+		logmode = LOGMODE_NONE;
 
-	chp = argv[optind];
-	if (!chp) {
-		/* GNU coreutils 8.4:
-		 * bare "mktemp" -> "mktemp -t tmp.XXXXXX"
-		 */
-		chp = xstrdup("tmp.XXXXXX");
-		opts |= OPT_t;
+	tmpl = argv[optind];
+	if (!tmpl) {
+		/* GNU: tmp.XXXXXXXXXX, in the base directory */
+		tmpl = (char*)"tmp.XXXXXXXXXX";
+		if (!(opts & (OPT_p | OPT_tmpdir)))
+			opts |= OPT_tmpdir;
 	}
-#if 0
-	/* Don't allow directory separator in template */
-	if ((opts & OPT_t) && bb_basename(chp) != chp) {
-		errno = EINVAL;
-		goto error;
+	if (suffix) {
+		if (strchr(suffix, '/'))
+			bb_error_msg_and_die("invalid suffix '%s', contains directory separator", suffix);
+		len = strlen(tmpl);
+		if (!len || tmpl[len - 1] != 'X')
+			bb_error_msg_and_die("with --suffix, template '%s' must end in X", tmpl);
 	}
-#endif
-	if (opts & (OPT_t|OPT_p|OPT_tmpdir))
-		chp = concat_path_file(path, chp);
-
-	if (opts & OPT_u) {
-		chp = mktemp(chp);
-		if (chp[0] == '\0')
-			goto error;
-	} else if (opts & OPT_d) {
-		if (mkdtemp(chp) == NULL)
-			goto error;
+	if (opts & OPT_t) {
+		/* the name, in $TMPDIR, else -p DIR, else /tmp */
+		if (strchr(tmpl, '/'))
+			bb_error_msg_and_die("invalid template, '%s', contains directory separator", tmpl);
+		dir = tmpdir ? tmpdir : dir ? dir : "/tmp";
+	} else if (opts & (OPT_p | OPT_tmpdir)) {
+		if (!dir || !dir[0])
+			dir = tmpdir ? tmpdir : "/tmp";
+		if (tmpl[0] == '/')
+			bb_error_msg_and_die("invalid template, '%s'; with --tmpdir, it may not be absolute", tmpl);
 	} else {
-		if (mkstemp(chp) < 0)
-			goto error;
+		dir = NULL;
 	}
-	puts(chp);
-	return EXIT_SUCCESS;
- error:
-	if (opts & OPT_q)
+	name = dir ? concat_path_file(dir, tmpl) : xstrdup(tmpl);
+	if (suffix) {
+		char *t = xasprintf("%s%s", name, suffix);
+		free(name);
+		name = t;
+	}
+
+	/* the last run of X's in the last component */
+	base = (char*)bb_basename(name);
+	x_end = NULL;
+	for (x_start = base + strlen(base); x_start > base; x_start--) {
+		if (x_start[-1] == 'X') {
+			x_end = x_start;
+			while (x_start > base && x_start[-1] == 'X')
+				x_start--;
+			break;
+		}
+	}
+	if (!x_end || x_end - x_start < 3) {
+		bb_error_msg("too few X's in template '%s'", tmpl);
 		return EXIT_FAILURE;
-	/* don't use chp as it gets mangled in case of error */
-	bb_perror_nomsg_and_die();
+	}
+
+	for (tries = 0; tries < 10000; tries++) {
+		char *c;
+		for (c = x_start; c < x_end; c++)
+			*c = chars[random_byte() % (sizeof(chars) - 1)];
+		if (opts & OPT_u) {
+			struct stat st;
+			if (lstat(name, &st) == 0)
+				continue;
+			break;
+		}
+		if (opts & OPT_d) {
+			if (mkdir(name, 0700) == 0)
+				break;
+		} else {
+			int fd = open(name, O_RDWR | O_CREAT | O_EXCL, 0600);
+			if (fd >= 0) {
+				close(fd);
+				break;
+			}
+		}
+		if (errno != EEXIST) {
+			/* the template, as it was given */
+			memset(x_start, 'X', x_end - x_start);
+			bb_perror_msg("failed to create %s via template '%s'", (opts & OPT_d) ? "directory" : "file", name);
+			return EXIT_FAILURE;
+		}
+	}
+	puts(name);
+	return EXIT_SUCCESS;
 }
