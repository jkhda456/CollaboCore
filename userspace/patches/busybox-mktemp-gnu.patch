@@ -60,74 +59,132 @@
 
 #include "libbb.h"
 
+/* names need not be secret, only unlikely to be taken: xorshift from the clock and the pid */
+static unsigned random_byte(void)
+{
+	static unsigned long long state;
+	if (!state)
+		state = monotonic_ns() ^ ((unsigned long long)getpid() << 32) ^ (uintptr_t)&state ^ time(NULL);
+	state ^= state << 13;
+	state ^= state >> 7;
+	state ^= state << 17;
+	return (unsigned)(state >> 24);
+}
+
 int mktemp_main(int argc, char **argv) MAIN_EXTERNALLY_VISIBLE;
 int mktemp_main(int argc UNUSED_PARAM, char **argv)
 {
-	const char *path;
-	char *chp;
-	unsigned opts;
+	static const char chars[] ALIGN1 =
+		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+	const char *tmpdir, *dir = NULL, *suffix = NULL;
+	char *tmpl, *name, *base, *x_end, *x_start;
+	unsigned opts, tries;
+	size_t len;
 	enum {
 		OPT_d = 1 << 0,
 		OPT_q = 1 << 1,
 		OPT_t = 1 << 2,
 		OPT_p = 1 << 3,
 		OPT_u = 1 << 4,
-		OPT_tmpdir = (1 << 5) * ENABLE_LONG_OPTS,
+		OPT_tmpdir = 1 << 5,
+		OPT_suffix = 1 << 6,
 	};
 
-	path = getenv("TMPDIR");
-	if (!path || path[0] == '\0')
-		path = "/tmp";
+	tmpdir = getenv("TMPDIR");
+	if (tmpdir && !tmpdir[0])
+		tmpdir = NULL;
 
-#if ENABLE_LONG_OPTS
 	opts = getopt32long(argv, "^"
-		"dqtp:u"
