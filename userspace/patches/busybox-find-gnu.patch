+/* -printf FORMAT's warnings, once, as GNU gives them */
+static void find_printf_check(const char *fmt)
+{
+	const char *f;
+
+	for (f = fmt; *f; f++) {
+		if (*f == '\\') {
+			if (!*++f) {
+				bb_simple_error_msg("warning: escape `\\' followed by nothing at all");
+				break;
+			}
+			if (!strchr("abcfnrtv\\01234567", *f))
+				bb_error_msg("warning: unrecognized escape `\\%c'", *f);
+		} else if (*f == '%') {
+			f++;
+			f += strspn(f, "-+ #0123456789.");
+			if (!*f)
+				bb_simple_error_msg_and_die("error: % at end of format string");
+			if (strchr("ACT", *f)) {
+				if (!f[1])
+					bb_error_msg("warning: format directive `%%%c' should be followed by another character", *f);
+				else
+					f++;
+			} else if (!strchr("%pfhHPdDinsbkmMuUgGlyYFSZact", *f)) {
+				bb_error_msg("warning: unrecognized format directive `%%%c'", *f);
+			}
+		}
+	}
+}
+
+static void find_printf(FILE *out, const char *fmt, const char *fileName, const struct stat *st)
+{
+	const char *f = fmt;
+	char buf[PATH_MAX + 64];
+
+	while (*f) {
+		if (*f == '\\') {
+			const char *e = f + 1;
+			int c = *e;
+			if (c >= '0' && c <= '7') {
+				int n = 0, i;
+				for (i = 0; i < 3 && *e >= '0' && *e <= '7'; i++)
+					n = n * 8 + (*e++ - '0');
+				putc(n, out);
+				f = e;
+				continue;
+			}
+			switch (c) {
+			case 'a': c = '\a'; break;
+			case 'b': c = '\b'; break;
+			case 'f': c = '\f'; break;
+			case 'n': c = '\n'; break;
+			case 'r': c = '\r'; break;
+			case 't': c = '\t'; break;
+			case 'v': c = '\v'; break;
+			case '\\': break;
+			case 'c': return; /* no more of this format */
+			case '\0': putc('\\', out); return;
+			default: putc('\\', out); break; /* as it is */
+			}
+			putc(c, out);
+			f = e + 1;
+			continue;
+		}
+		if (*f != '%') {
+			putc(*f++, out);
+			continue;
+		}
+		{
+			/* %[flags][width][.precision]X: flags, width and precision as for a string */
+			const char *start = f++, *val;
+			char spec[32];
+			int n = 0, alt = 0;
+
+			spec[n++] = '%';
+			for (; *f && strchr("-+ #0", *f); f++) {
+				if (*f == '-' && n == 1)
+					spec[n++] = '-';
+				if (*f == '#')
+					alt = 1;
+			}
+			for (; isdigit((unsigned char)*f); f++)
+				if (n < 12) spec[n++] = *f;
+			if (*f == '.') {
+				spec[n++] = *f++;
+				for (; isdigit((unsigned char)*f); f++)
+					if (n < 24) spec[n++] = *f;
+			}
+			spec[n++] = 's';
+			spec[n] = '\0';
+			if (!*f) {
+				putc('%', out);
+				break;
+			}
+			if (*f == '%') {
+				/* GNU: "%%" is %, "%5%" is %5 */
+				fwrite(start, 1, f - start, out);
+				f++;
+				continue;
+			}
+			val = find_directive(buf, sizeof(buf), &f, fileName, st, alt);
+			if (!val)
+				fwrite(start, 1, f - start, out); /* as it is */
+			else
+				fprintf(out, spec, val);
+		}
+	}
+}
