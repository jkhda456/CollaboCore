+/* -execdir: the folder of fileName to run in, and ./NAME for {} */
+static char *exec_dir_of(const char *fileName, char **name)
+{
+	const char *e = fileName + strlen(fileName), *b;
+
+	while (e > fileName + 1 && e[-1] == '/')
+		e--;
+	b = e;
+	while (b > fileName && b[-1] != '/')
+		b--;
+	*name = xasprintf("./%.*s", (int)(e - b), b);
+	if (b == fileName)
+		return xstrdup(".");
+	return xstrndup(fileName, b - fileName > 1 ? b - fileName - 1 : 1);
+}
