+/* a -printf directive at *pf (past the %): its text in buf, or NULL if there is none such */
+static const char *find_directive(char *buf, size_t size, const char **pf,
+		const char *fileName, const struct stat *st, int alt)
+{
+	const char *f = *pf;
+	int c = *f++;
+
+	*pf = f;
+	switch (c) {
+	case '%': return "%";
+	case 'p': return fileName;
+	case 'f': {
+		/* gnulib's base_name: the last component, with one '/' if it has any after it */
+		const char *end = fileName + strlen(fileName), *e = end, *b;
+		while (e > fileName + 1 && e[-1] == '/')
+			e--;
+		b = e;
+		while (b > fileName && b[-1] != '/')
+			b--;
+		if (b == e)
+			return "/";
+		snprintf(buf, size, "%.*s", (int)(e - b + (e < end)), b);
+		return buf;
+	}
+	case 'h': {
+		/* as GNU find 4.10 does it: the trailing '/'s go, but not after a name of one character
+		 * ("w/" gives "w", "ab/" "."), then what is before the last '/' */
+		char *t, *slash;
+		snprintf(buf, size, "%s", fileName);
+		t = buf + strlen(buf) - 1;
+		while (t >= buf && *t == '/')
+			t--;
+		if (buf < t && t[1] == '/')
+			t[1] = '\0';
+		slash = strrchr(buf, '/');
+		if (!slash)
+			return ".";
+		*slash = '\0';
+		return buf;
+	}
+	case 'H': return G.root;
+	case 'P': {
+		const char *p = fileName + strlen(G.root);
+		if (strncmp(fileName, G.root, strlen(G.root)) != 0)
+			return fileName;
+		return *p == '/' ? p + 1 : p;
+	}
+	case 'd': sprintf(buf, "%d", G.depth); return buf;
+	case 'D': sprintf(buf, "%llu", (unsigned long long)st->st_dev); return buf;
+	case 'i': sprintf(buf, "%llu", (unsigned long long)st->st_ino); return buf;
+	case 'n': sprintf(buf, "%lu", (unsigned long)st->st_nlink); return buf;
+	case 's': sprintf(buf, "%lld", (long long)st->st_size); return buf;
+	case 'b': sprintf(buf, "%lld", (long long)st->st_blocks); return buf;
+	case 'k': sprintf(buf, "%lld", (long long)(st->st_blocks + 1) / 2); return buf;
+	case 'm': sprintf(buf, alt ? "%#o" : "%o", (unsigned)(st->st_mode & 07777)); return buf;
+	case 'M': bb_mode_string(buf, st->st_mode); return buf;
+	case 'u': return get_cached_username(st->st_uid);
+	case 'U': sprintf(buf, "%lu", (unsigned long)st->st_uid); return buf;
+	case 'g': return get_cached_groupname(st->st_gid);
+	case 'G': sprintf(buf, "%lu", (unsigned long)st->st_gid); return buf;
+	case 'l': {
+		ssize_t n = S_ISLNK(st->st_mode) ? readlink(fileName, buf, size - 1) : -1;
+		buf[n > 0 ? n : 0] = '\0';
+		return buf;
+	}
+	case 'y': buf[0] = type_char(st->st_mode); buf[1] = '\0'; return buf;
+	case 'Y': {
+		struct stat t;
+		buf[0] = type_char(st->st_mode);
+		if (S_ISLNK(st->st_mode))
+			buf[0] = stat(fileName, &t) == 0 ? type_char(t.st_mode)
+				: errno == ENOENT ? 'N' : errno == ELOOP ? 'L' : '?';
+		buf[1] = '\0';
+		return buf;
+	}
+	case 'F': return fstype_of(st->st_dev);
+	case 'S': {
+		double sparse = st->st_size ? 512.0 * st->st_blocks / st->st_size : st->st_blocks ? 1.0 / 0.0 : 1.0;
+		snprintf(buf, size, "%g", sparse);
+		return buf;
+	}
+	case 'Z': return ""; /* no SELinux here */
+	case 'a': find_time(buf, size, &st->st_atim, 0); return buf;
+	case 'c': find_time(buf, size, &st->st_ctim, 0); return buf;
+	case 't': find_time(buf, size, &st->st_mtim, 0); return buf;
+	case 'A': case 'C': case 'T':
+		if (!*f)
+			return NULL;
+		*pf = f + 1;
+		if (!strchr(find_time_kinds, *f)) {
+			/* GNU prints % and the character */
+			sprintf(buf, "%%%c", *f);
+			return buf;
+		}
+		find_time(buf, size, c == 'A' ? &st->st_atim : c == 'C' ? &st->st_ctim : &st->st_mtim, *f);
+		return buf;
+	}
+	return NULL;
+}
