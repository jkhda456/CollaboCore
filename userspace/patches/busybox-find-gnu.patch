+/* GNU find's default -regex syntax, emacs's, as an ERE: \( \) \| group and alternate, ( ) | { }
+ * are themselves */
+static char *emacs_to_ere(const char *s)
+{
+	char *out = xmalloc(strlen(s) * 2 + 1), *o = out;
+
+	while (*s) {
+		if (*s == '\\' && s[1]) {
+			char c = s[1];
+			s += 2;
+			if (c != '(' && c != ')' && c != '|')
+				*o++ = '\\';
+			*o++ = c;
+			continue;
+		}
+		if (*s == '[') {
+			*o++ = *s++;
+			if (*s == '^')
+				*o++ = *s++;
+			if (*s == ']')
+				*o++ = *s++;
+			while (*s && *s != ']') {
+				if (s[0] == '[' && (s[1] == ':' || s[1] == '.' || s[1] == '=')) {
+					char end = s[1];
+					*o++ = *s++;
+					*o++ = *s++;
+					while (*s && !(s[0] == end && s[1] == ']'))
+						*o++ = *s++;
+					if (*s) {
+						*o++ = *s++;
+						*o++ = *s++;
+					}
+				} else {
+					*o++ = *s++;
+				}
+			}
+			if (*s)
+				*o++ = *s++;
+			continue;
+		}
+		if (strchr("(){}|", *s))
+			*o++ = '\\';
+		*o++ = *s++;
+	}
+	*o = '\0';
+	return out;
+}
