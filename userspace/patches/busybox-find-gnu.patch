+static void find_ls(FILE *out, const char *fileName, const struct stat *st)
+{
+	char mode[12], when[64];
+	struct tm tm;
+	time_t now = time(NULL);
+
+	fprintf(out, "%9llu %6llu %s %3lu %-8s %-8s ", (unsigned long long)st->st_ino,
+		(unsigned long long)(st->st_blocks + 1) / 2, bb_mode_string(mode, st->st_mode),
+		(unsigned long)st->st_nlink, get_cached_username(st->st_uid), get_cached_groupname(st->st_gid));
+	if (S_ISCHR(st->st_mode) || S_ISBLK(st->st_mode))
+		fprintf(out, "%3u, %3u ", (unsigned)major(st->st_rdev), (unsigned)minor(st->st_rdev));
+	else
+		fprintf(out, "%8lld ", (long long)st->st_size);
+	when[0] = '\0';
+	if (localtime_r(&st->st_mtime, &tm)) {
+		/* recent: the last six months (of 365.2425 days) */
+		int recent = st->st_mtime <= now && st->st_mtime >= now - 31556952 / 2;
+		strftime(when, sizeof(when), recent ? "%b %e %H:%M" : "%b %e  %Y", &tm);
+	}
+	fprintf(out, "%s %s", when, fileName);
+	if (S_ISLNK(st->st_mode)) {
+		char *target = xmalloc_readlink(fileName);
+		fprintf(out, " -> %s", target ? target : "");
+		free(target);
+	}
+	putc('\n', out);
+}
+
+ACTF(printf)
+{
+	if (ap->kind == 'f')
+		find_printf(ap->out, ap->fmt, fileName, statbuf);
+	else if (ap->kind == 'l')
+		find_ls(ap->out, fileName, statbuf);
+	else {
+		fputs(fileName, ap->out);
+		putc(ap->kind == '0' ? '\0' : '\n', ap->out);
+	}
+	return TRUE;
+}
+ACTF(constant)
+{
+	return ap->value;
+}
+ACTF(access)
+{
+	return access(fileName, ap->mode) == 0;
+}
+ACTF(lname)
+{
+	char *target;
+	int r;
+
+	if (!S_ISLNK(statbuf->st_mode))
+		return FALSE;
+	target = xmalloc_readlink(fileName);
+	r = target && fnmatch(ap->pattern, target, ap->icase ? FNM_CASEFOLD : 0) == 0;
+	free(target);
+	return r;
+}
+ACTF(xtype)
+{
+	/* the type -type does not look at: a link's target's, or with -L the link's own */
+	struct stat st;
+	mode_t m = statbuf->st_mode;
+
+	if (G.recurse_flags & ACTION_FOLLOWLINKS) {
+		if (lstat(fileName, &st) == 0)
+			m = st.st_mode;
+	} else if (S_ISLNK(m) && stat(fileName, &st) == 0) {
+		m = st.st_mode;
+	}
+	return (ap->types >> ((m & S_IFMT) >> 12)) & 1;
+}
+ACTF(id)
+{
+	unsigned long v = ap->group ? statbuf->st_gid : statbuf->st_uid;
+	return ap->cmp == '+' ? v > ap->id : ap->cmp == '-' ? v < ap->id : v == ap->id;
+}
+ACTF(noid)
+{
+	return ap->group ? getgrgid(statbuf->st_gid) == NULL : getpwuid(statbuf->st_uid) == NULL;
+}
+ACTF(used)
+{
+	/* as GNU find 4.10 counts it, d = atime - ctime: never when d < 0; N: (N-1) days <= d < N days;
+	 * +N: d > N days; -N: d < N days */
+	double d = (statbuf->st_atim.tv_sec - statbuf->st_ctim.tv_sec)
+		+ (statbuf->st_atim.tv_nsec - statbuf->st_ctim.tv_nsec) / 1e9;
+	double n = (double)ap->days * 86400;
+	if (d < 0)
+		return FALSE;
+	if (ap->cmp == '+')
+		return d > n;
+	if (ap->cmp == '-')
+		return d < n;
+	return d >= n - 86400 && d < n;
+}
+ACTF(fstype)
+{
+	return strcmp(fstype_of(statbuf->st_dev), ap->type) == 0;
+}
+
+static FILE *find_open(const char *name)
+{
+	struct find_out *o;
+
+	if (strcmp(name, "/dev/stdout") == 0)
+		return stdout;
+	if (strcmp(name, "/dev/stderr") == 0)
+		return stderr;
+	for (o = G.outs; o; o = o->next) {
+		if (strcmp(o->name, name) == 0)
+			return o->fp;
+	}
+	o = xzalloc(sizeof(*o));
+	o->name = name;
+	o->fp = xfopen_for_write(name);
+	o->next = G.outs;
+	G.outs = o;
+	return o->fp;
+}
