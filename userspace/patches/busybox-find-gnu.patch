+/* a time as GNU find prints it: kind 0 for %a %c %t ("Mon Nov  2 00:50:21.4811880850 2026"),
+ * '@' for seconds since the epoch, else a strftime conversion; S T X + carry the fraction after
+ * the seconds, ten digits as GNU's */
+static void find_time(char *buf, size_t size, const struct timespec *ts, int kind)
+{
+	struct tm tm;
+	char ns[16];
+
+	sprintf(ns, ".%09ld0", (long)ts->tv_nsec);
+	if (kind == '@' || !localtime_r(&ts->tv_sec, &tm)) {
+		snprintf(buf, size, "%lld%s", (long long)ts->tv_sec, kind == '@' ? ns : "");
+		return;
+	}
+	if (kind == 0) {
+		char a[64], y[16];
+		strftime(a, sizeof(a), "%a %b %e %H:%M:%S", &tm);
+		strftime(y, sizeof(y), "%Y", &tm);
+		snprintf(buf, size, "%s%s %s", a, ns, y);
+	} else {
+		/* '_' keeps an empty expansion (%p in some locales) apart from an error */
+		char fmt[8] = "_%?", a[128], b[128];
+		size_t n, i;
+
+		if (kind == '+')
+			strcpy(fmt, "_%F+%T");
+		else
+			fmt[2] = kind;
+		/* glibc's, which musl's strftime has not */
+		if (kind == 'k' || kind == 'l') {
+			snprintf(buf, size, "%2d", kind == 'k' ? tm.tm_hour : (tm.tm_hour + 11) % 12 + 1);
+			return;
+		}
+		if (kind == 'P') {
+			snprintf(buf, size, "%s", tm.tm_hour < 12 ? "am" : "pm");
+			return;
+		}
+		n = strftime(a, sizeof(a), fmt, &tm);
+		buf[0] = '\0';
+		if (n == 0)
+			return;
+		if (strchr("STX+", kind)) {
+			/* where the seconds are: where a time 11 seconds apart differs */
+			struct tm alt = tm;
+			alt.tm_sec += alt.tm_sec >= 11 ? -11 : 11;
+			strftime(b, sizeof(b), fmt, &alt);
+			for (i = 1; i < n && a[i] == b[i]; i++)
+				continue;
+			if (i + 2 <= n) {
+				snprintf(buf, size, "%.*s%s%s", (int)(i + 1), a + 1, ns, a + i + 2);
+				return;
+			}
+		}
+		snprintf(buf, size, "%s", a + 1);
+	}
+}
