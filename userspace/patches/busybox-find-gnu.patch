+/* -printf, -ls and the like */
+static char type_char(mode_t mode)
+{
+	switch (mode & S_IFMT) {
+	case S_IFREG: return 'f';
+	case S_IFDIR: return 'd';
+	case S_IFLNK: return 'l';
+	case S_IFBLK: return 'b';
+	case S_IFCHR: return 'c';
+	case S_IFIFO: return 'p';
+	case S_IFSOCK: return 's';
+	}
+	return 'U';
+}
+
+static const char *fstype_of(dev_t dev)
+{
+	int i;
+
+	if (!G.mounts_read) {
+		FILE *f = fopen_for_read("/proc/self/mountinfo");
+		char *line;
+
+		G.mounts_read = 1;
+		while (f && (line = xmalloc_fgetline(f)) != NULL) {
+			unsigned maj, min;
+			char *sep = strstr(line, " - ");
+			if (sep && sscanf(line, "%*u %*u %u:%u", &maj, &min) == 2) {
+				char *type = sep + 3;
+				type[strcspn(type, " ")] = '\0';
+				G.mounts = xrealloc_vector(G.mounts, 4, G.mounts_n);
+				G.mounts[G.mounts_n].dev = makedev(maj, min);
+				G.mounts[G.mounts_n++].type = xstrdup(type);
+			}
+			free(line);
+		}
+		if (f)
+			fclose(f);
+	}
+	for (i = G.mounts_n - 1; i >= 0; i--) {
+		if (G.mounts[i].dev == dev)
+			return G.mounts[i].type;
+	}
+	return "unknown";
+}
