# How wide a half block (▄) is here: two columns where the terminal draws East Asian ambiguous
# characters wide (Terminal.app's and iTerm2's option, often on in CJK setups), which wraps
# every line of $logo half way. Asked of the terminal: the cursor's column after one (ESC[6n).
half_block_wide() {
	[ -t 0 ] || return 1
	saved=$(stty -g 2>/dev/null) || return 1
	stty -echo -icanon 2>/dev/null
	printf '\r\342\226\204\033[6n'
	reply=
	IFS= read -r -s -t 1 -d R reply	# a second: at boot the guest is busy
	stty "$saved"
	printf '\r\033[K'
	case $reply in *\;3) return 0 ;; esac
	return 1
}

# The info beside the logo on stdin, from its line $1 on, $2 columns in, in a terminal $3 columns
# wide: each line cut at spaces to fit, its continuations under its value (a word longer than
# that cut where it must), the lines past the logo's end in the same column. With no logo (and
# 1 0), the info alone, cut the same way. So nothing the terminal wraps.
beside() {
	awk -v info="$info" -v first="$1" -v left="$2" -v cols="$3" '
		function fit(s, w,   ind, pad, out, cut, line) {
			sub(/ +$/, "", s)
			if (w < 1 || length(s) <= w) return s
			ind = match(s, /^[^ ]+ +/) ? RLENGTH : 0
			if (w - ind < 10) ind = 0
			pad = ""; while (length(pad) < ind) pad = pad " "
			out = ""
			while (length(s) > w) {
				cut = w + 1
				while (cut > ind + 1 && substr(s, cut, 1) != " ") cut--
				if (cut > ind + 1) { line = substr(s, 1, cut - 1); s = substr(s, cut + 1) }
				else { line = substr(s, 1, w); s = substr(s, w + 1) }
				sub(/ +$/, "", line); sub(/^ +/, "", s)
				out = out line "\n"
				s = pad s
			}
			return out s
		}
		BEGIN {
			n = split(info, raw, "\n")
			for (i = 1; i <= n; i++) {
				k = split(fit(raw[i], cols - left), part, "\n")
				if (k == 0) out[++m] = ""
				for (j = 1; j <= k; j++) out[++m] = part[j]
			}
			pad = ""; while (length(pad) < left) pad = pad " "
		}
		{
			gsub(/\\e/, "\033")
			i = NR - first + 1
			print $0 (i >= 1 && i <= m ? "  " out[i] : "")
		}
		END { for (i = NR - first + 2; i <= m; i++) if (i >= 1) print pad out[i] }
	'
}

cols=$(stty size 2>/dev/null); cols=${cols#* }
if [ -z "$plain" ] && [ -t 1 ] && [ -z "$NO_COLOR" ] && [ "$TERM" != dumb ] && [ "${cols:-80}" -ge "$logo_width" ]; then
	# Coloured spaces instead of half blocks where a half block is two columns wide (macOS's
	# terminals draw them short of the cell, but $logo leaves no gap there: see its comment).
	# COLLABO_LOGO=cells or blocks chooses.
	case ${COLLABO_LOGO:-auto} in
	cells) cells=1 ;;
	blocks) cells= ;;
	*) cells=; ! half_block_wide || cells=1 ;;
	esac
	if [ -n "$cells" ]; then
		logo=$logo_cells
		logo_info=$logo_cells_info
	fi
	# The lines under the word, two columns right of the image.
	printf '%s\n' "$logo" | beside "$logo_info" "$logo_left" "${cols:-80}"
elif [ -t 1 ] && [ -n "$cols" ]; then
	beside 1 0 "$cols" </dev/null
else
	printf '%s\n' "$info"
fi
