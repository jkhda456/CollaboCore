#!/bin/sh
# version: what this sandbox is: the collaboCore engine's version (collabo.version on the kernel
# command line), the kernel, busybox and the add-ons the machine was started with. On a terminal,
# beside the collaboCore logo and under its name in large letters (24-bit colour, in this file:
# see $logo below); piped, or with NO_COLOR or TERM=dumb, the lines alone. /etc/rc runs it at
# boot, before the shell.
#
#   version             all of it
#   version --version   the lines alone, without the logo, on a terminal too
#   version -s          the collaboCore version alone
short= plain=
case $1 in
-s|--short) short=1 ;;
--version) plain=1 ;;
"") ;;
-h|--help) echo "usage: version [-s | --version]   collaboCore, kernel, busybox and add-on versions"; exit 0 ;;
*) echo "usage: version [-s | --version]" >&2; exit 2 ;;
esac

v=
for a in $(cat /proc/cmdline 2>/dev/null); do
	case $a in collabo.version=*) v=${a#*=} ;; esac
done
if [ -n "$short" ]; then
	echo "${v:-unknown}"
	exit 0
fi

addons=
for f in /etc/collabo/addons/*.json; do
	[ -f "$f" ] || continue
	n=${f##*/}
	addons="$addons ${n%.json}"
done
info="collaboCore ${v:-(unknown: an engine older than collabo.version)}
kernel      $(uname -sr) ($(uname -m))
busybox     $(busybox 2>&1 | sed -n '1s/^BusyBox \(v[^ ]*\).*/\1/p')
add-ons    ${addons:- none}"

