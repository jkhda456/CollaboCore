-writechild(int fd, const void *old, size_t n)
+/*
+ * The guest has no fork: the writer is a thread, which owns the pipe's
+ * write end and closes it when done (or when the decompressor went away).
+ */
+struct writer {
+	pthread_t thread;
+	int fd;
+	const void *buf;
+	size_t n;
+};
+
+static void *
+writer_main(void *v)
 {
-	pid_t pid;
+	struct writer *w = CAST(struct writer *, v);
 
-	/*
-	 * fork again, to avoid blocking because both
-	 * pipes filled
-	 */
-	pid = fork();
-	if (pid == -1) {
-		DPRINTF("Fork failed (%s)\n", strerror(errno));
+	if (swrite(w->fd, w->buf, w->n) != CAST(ssize_t, w->n))
+		DPRINTF("Write failed (%s)\n", strerror(errno));
+	(void)close(w->fd);
+	return NULL;
+}
+
+static int
+writechild(struct writer *w, int fd, const void *old, size_t n)
+{
+	int e;
+
+	w->fd = fd;
+	w->buf = old;
+	w->n = n;
+	if ((e = pthread_create(&w->thread, NULL, writer_main, w)) != 0) {
+		DPRINTF("Thread failed (%s)\n", strerror(e));
+		errno = e;
 		return -1;
 	}
-	if (pid == 0) {
-		/* child */
-		if (swrite(fd, old, n) != CAST(ssize_t, n)) {
-			DPRINTF("Write failed (%s)\n", strerror(errno));
-			exit(EXIT_FAILURE);
-		}
-		exit(EXIT_SUCCESS);
-	}
-	/* parent */
-	return pid;
+	return 0;
 }
 
