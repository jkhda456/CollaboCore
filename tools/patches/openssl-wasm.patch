-#ifdef SIGALRM
+#if defined(SIGALRM) && defined(__wasm__)
+
+/*
+ * The wasm guest hands a process its signals when it enters the kernel, which the benchmark
+ * loops never do: SIGALRM would not end them. As on Windows, a thread ends them instead, by
+ * clearing run (memory is shared) when the lapse is over.
+ */
+#include <pthread.h>
+
+static unsigned int lapse;
+static volatile int stopped;
+static pthread_t sleeper;
+
+static void alarmed(ossl_unused int sig)
+{
+    run = 0;
+}
+
+static void alarm_wasm(unsigned int secs)
+{
+    lapse = secs;
+}
+
+#define alarm alarm_wasm
+
+static void *sleepy(ossl_unused void *arg)
+{
+    struct timespec end, now, step = { 0, 10 * 1000 * 1000 };
+
+    clock_gettime(CLOCK_MONOTONIC, &end);
+    end.tv_sec += lapse;
+    while (!stopped) {
+        clock_gettime(CLOCK_MONOTONIC, &now);
+        if (now.tv_sec > end.tv_sec
+            || (now.tv_sec == end.tv_sec && now.tv_nsec >= end.tv_nsec)) {
+            run = 0;
+            break;
+        }
+        nanosleep(&step, NULL);
+    }
+    return NULL;
+}
+
+static double Time_F(int s)
+{
+    double ret;
+
+    if (s == START) {
+        stopped = 0;
+        if (pthread_create(&sleeper, NULL, sleepy, NULL) != 0) {
+            BIO_printf(bio_err, "unable to start the timer thread\n");
+            exit(1);
+        }
+        return app_tminterval(s, usertime);
+    }
+    ret = app_tminterval(s, usertime);
+    stopped = 1;
+    pthread_join(sleeper, NULL);
+    return ret;
+}
+
