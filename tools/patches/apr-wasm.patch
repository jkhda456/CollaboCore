+/* Children start without fork(), which needs an MMU that Linux compiled to
+ * WebAssembly has not: like musl's posix_spawn, clone(CLONE_VM | CLONE_VFORK)
+ * runs proc_child_main on a stack of its own, in our memory, while this
+ * thread waits until the child calls exec or exits. Whatever the child
+ * changes in memory, it changes for us; so the shell command line is made
+ * before, and apr_pool_cleanup_for_exec() does not run (it would take the
+ * cleanups off our pools; what it is for, closing descriptors that are not
+ * for the child, APR's own files, pipes and sockets do with close-on-exec).
+ * errfn still runs in the child, on the child's standard descriptors, as
+ * callers expect (Subversion's write the error there for the parent to read):
+ * what it allocates from the pool is as if this thread had, which waits
+ * meanwhile. Signals stay blocked until the ones we catch are back at their
+ * default.
+ */
+#define PROC_CHILD_STACK (256 * 1024)  /* for errfn too */
+
+struct proc_child {
+    apr_procattr_t *attr;
+    apr_pool_t *pool;
+    const char *name;          /* the progname we were given */
+    const char *progname;      /* SHELL_PATH for a shell command */
+    const char * const *args;  /* and the shell's arguments */
+    const char * const *env;
+    sigset_t mask;             /* the parent's */
+};
+
+static void proc_child_fail(struct proc_child *c, apr_status_t err,
+                            const char *desc)
+{
+    if (c->attr->errfn) {
+        c->attr->errfn(c->pool, err, desc);
+    }
+    _exit(-1);   /* We have big problems, the child should exit. */
+}
+
+static void proc_child_stdio(apr_file_t *f, int fd)
+{
+    if (f && f->filedes == -1) {
+        close(fd);
+    }
+    else if (f && f->filedes != fd) {
+        dup2(f->filedes, fd);
+        close(f->filedes);
+    }
+}
+
+static int proc_child_main(void *arg)
+{
+    struct proc_child *c = arg;
+    apr_procattr_t *attr = c->attr;
+    struct sigaction sa;
+    int sig, err;
+
+    for (sig = 1; sig < _NSIG; sig++) {
+        if (sigaction(sig, NULL, &sa) == 0 && sa.sa_handler != SIG_DFL
+            && sa.sa_handler != SIG_IGN) {
+            memset(&sa, 0, sizeof(sa));
+            sa.sa_handler = SIG_DFL;
+            sigaction(sig, &sa, NULL);
+        }
+    }
+    signal(SIGCHLD, SIG_DFL); /* not sure if this is needed or not */
+    sigprocmask(SIG_SETMASK, &c->mask, NULL);
+
+    proc_child_stdio(attr->child_in, STDIN_FILENO);
+    proc_child_stdio(attr->child_out, STDOUT_FILENO);
+    proc_child_stdio(attr->child_err, STDERR_FILENO);
+
+    if (attr->currdir != NULL) {
+        if (chdir(attr->currdir) == -1) {
+            proc_child_fail(c, errno, "change of working directory failed");
+        }
+    }
+    if (!geteuid()) {
+        apr_procattr_pscb_t *p = attr->perms_set_callbacks;
+
+        while (p) {
+            apr_status_t r;
+            r = (*p->perms_set_fn)((void *)p->data, p->perms,
+                                   attr->uid, attr->gid);
+            if (r != APR_SUCCESS && r != APR_ENOTIMPL) {
+                _exit(-1);
+            }
+            p = p->next;
+        }
+    }
+    /* Only try to switch if we are running as root */
+    if (attr->gid != -1 && !geteuid()) {
+        if (setgid(attr->gid)) {
+            proc_child_fail(c, errno, "setting of group failed");
+        }
+    }
+
+    if (attr->uid != -1 && !geteuid()) {
+        if (setuid(attr->uid)) {
+            proc_child_fail(c, errno, "setting of user failed");
+        }
+    }
+
+    if (limit_proc(attr) != APR_SUCCESS) {
+        proc_child_fail(c, errno, "setting of resource limits failed");
+    }
+
+    if (attr->detached) {
+        /* apr_proc_detach(APR_PROC_DETACH_DAEMONIZE) without its stdio:
+         * a new session in / with the standard descriptors on /dev/null. */
+        int fd = open("/dev/null", O_RDWR);
+
+        if (chdir("/") == -1 || setsid() == -1 || fd == -1) {
+            proc_child_fail(c, errno, "detaching failed");
+        }
+        dup2(fd, STDIN_FILENO);
+        dup2(fd, STDOUT_FILENO);
+        dup2(fd, STDERR_FILENO);
+        if (fd > STDERR_FILENO) {
+            close(fd);
+        }
+    }
+
+    if (attr->cmdtype == APR_SHELLCMD || attr->cmdtype == APR_PROGRAM) {
+        execve(c->progname, (char * const *)c->args, (char * const *)c->env);
+    }
+    else if (attr->cmdtype == APR_SHELLCMD_ENV ||
+             attr->cmdtype == APR_PROGRAM_ENV) {
+        execv(c->progname, (char * const *)c->args);
+    }
+    else {
+        /* APR_PROGRAM_PATH */
+        execvp(c->progname, (char * const *)c->args);
+    }
+    err = errno;
+    proc_child_fail(c, err, apr_psprintf(c->pool, "exec of '%s' failed",
+                                         c->name));
+    return -1;
+}
