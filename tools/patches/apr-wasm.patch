+/* The default errfn: fprintf itself returns int, not void, and a call through
+ * a pointer of the wrong type traps in WebAssembly. */
+static void getopt_fprintf(void *arg, const char *fmt, ...)
+{
+    va_list ap;
+
+    va_start(ap, fmt);
+    vfprintf(arg, fmt, ap);
+    va_end(ap);
+}
