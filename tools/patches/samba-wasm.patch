+@TaskGen.feature('c')
+@TaskGen.before_method('process_source', 'apply_link')
+def samba_hostcc_env(self):
+    '''when cross-compiling with --hostcc, compile and link the use_hostcc targets
+    (the build's own tools, such as Heimdal's asn1_compile and compile_et, which the
+    build runs) with that compiler, without the target's CPPFLAGS and LDFLAGS'''
+    if not getattr(self, 'samba_use_hostcc', False):
+        return
+    if not self.env.CROSS_COMPILE or not self.env.HOSTCC:
+        return
+    self.env = self.env.derive()
+    self.env.CC = Utils.to_list(self.env.HOSTCC)
+    self.env.LINK_CC = Utils.to_list(self.env.HOSTCC)
+    self.env.CPPFLAGS = []
+    self.env.LDFLAGS = []
+
