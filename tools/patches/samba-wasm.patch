 	return NULL;
 }
 
+#if defined(HAVE_LIBREADLINE) && defined(HAVE_DECL_RL_EVENT_HOOK)
+/*
+ * rl_event_hook returns an int: calling the void callback through it
+ * is a call of another type, which WebAssembly checks (and traps on).
+ */
+static void (*smb_readline_event_callback)(void);
+
+static int smb_readline_event_hook(void)
+{
+	smb_readline_event_callback();
+	return 0;
+}
+#endif
