diff --git a/lib/util/stable_sort.c b/lib/util/stable_sort.c
index 47667c4..8856913 100644
--- a/lib/util/stable_sort.c
+++ b/lib/util/stable_sort.c
@@ -219,22 +219,30 @@ bool stable_sort_talloc_r(TALLOC_CTX *mem_ctx,
 }
 
 
+/*
+ * The two-argument cmpfn is called by a three-argument one that has it as
+ * its context: calling it through the three-argument type (one argument
+ * the callee does not take) works on most ABIs, but WebAssembly checks the
+ * type of each indirect call and traps.
+ */
+struct stable_sort_cmp {
+	samba_compare_fn_t fn;
+};
+
+static int stable_sort_call_cmp(const void *a, const void *b, void *opaque)
+{
+	const struct stable_sort_cmp *cmp = opaque;
+	return cmp->fn(a, b);
+}
+
 bool stable_sort(void *array, void *aux,
 		 size_t n,
 		 size_t s,
 		 samba_compare_fn_t cmpfn)
 {
-	/*
-	 * What is this magic, casting cmpfn into a different type that takes
-	 * an extra parameter? Is that allowed?
-	 *
-	 * A: Yes. It's fine. The extra argument will be passed on the stack
-	 * or (more likely) a register, and the cmpfn will remain blissfully
-	 * unaware.
-	 */
-	return stable_sort_r(array, aux, n, s,
-			     (samba_compare_with_context_fn_t)cmpfn,
-			     NULL);
+	struct stable_sort_cmp cmp = { .fn = cmpfn };
+
+	return stable_sort_r(array, aux, n, s, stable_sort_call_cmp, &cmp);
 }
 
 
@@ -244,7 +252,8 @@ bool stable_sort_talloc(TALLOC_CTX *mem_ctx,
 			size_t s,
 			samba_compare_fn_t cmpfn)
 {
+	struct stable_sort_cmp cmp = { .fn = cmpfn };
+
 	return stable_sort_talloc_r(mem_ctx, array, n, s,
-				    (samba_compare_with_context_fn_t)cmpfn,
-				    NULL);
+				    stable_sort_call_cmp, &cmp);
 }
diff --git a/lib/util/util.c b/lib/util/util.c
index bd610fa..ec18ecc 100644
--- a/lib/util/util.c
+++ b/lib/util/util.c
@@ -1166,7 +1166,17 @@ void *anonymous_shared_allocate(size_t orig_bufsz)
 		return NULL;
 	}
 
-#ifdef MAP_ANON
+#ifndef HAVE_MMAP
+	/*
+	 * No mmap() (the collaboCore guest): nor is there fork(), the only
+	 * way another process would share an anonymous mapping, so plain
+	 * zeroed memory is the same thing here.
+	 */
+	buf = calloc(1, bufsz);
+	if (buf == NULL) {
+		return NULL;
+	}
+#elif defined(MAP_ANON)
 	/* BSD */
 	buf = mmap(NULL, bufsz, PROT_READ|PROT_WRITE, MAP_ANON|MAP_SHARED,
 			-1 /* fd */, 0 /* offset */);
@@ -1188,9 +1198,11 @@ void *anonymous_shared_allocate(size_t orig_bufsz)
 }
 #endif
 
+#ifdef HAVE_MMAP
 	if (buf == MAP_FAILED) {
 		return NULL;
 	}
+#endif
 
 	hdr = (struct anonymous_shared_header *)buf;
 	hdr->u.length = bufsz;
@@ -1276,7 +1288,11 @@ void anonymous_shared_free(void *ptr)
 
 	hdr--;
 
+#ifdef HAVE_MMAP
 	munmap(hdr, hdr->u.length);
+#else
+	free(hdr);
+#endif
 }
 
