+#ifdef __wasm__
+/* collaboCore: the guest (WebAssembly Linux) has no fork(). The children of system(), qx// and
+ * piped opens start with posix_spawn instead: which program runs, with which arguments, is
+ * decided as do_exec3 and do_aexec5 decide what to exec (the command line itself unless it needs
+ * the shell; ENOEXEC falls back to the shell), and what the child would do between fork and exec
+ * (its end of a pipe on standard input or output, 2>&1) is posix_spawn's file actions. A spawn
+ * that fails warns "Can't exec" here, where the child would have, and returns -1 with errno set.
+ * fork itself stays unsupported ("Unsupported function fork"), as on a system without one. */
+
+static Pid_t
+S_wasm_spawnv(pTHX_ const char *file, const char **argv, posix_spawn_file_actions_t *fa)
+{
+    Pid_t pid;
+    const int e = posix_spawnp(&pid, file, fa, NULL, (char *const *)argv, environ);
+    if (e) {
+        errno = e;
+        return -1;
+    }
+    return pid;
+}
+
+static Pid_t
+S_wasm_spawn_sh(pTHX_ const char *cmd, posix_spawn_file_actions_t *fa)
+{
+    const char *argv[] = { "sh", "-c", cmd, NULL };
+    Pid_t pid;
+    const int e = posix_spawn(&pid, PL_sh_path, fa, NULL, (char *const *)argv, environ);
+    if (e) {
+        errno = e;
+        ck_warner(packWARN(WARN_EXEC), "Can't exec \"%s\": %s", PL_sh_path, Strerror(e));
+        return -1;
+    }
+    return pid;
+}
+
+/* do_exec3's choice for the command line `incmd`, spawned with `fa` */
+Pid_t
+Perl_wasm_spawn3(pTHX_ const char *incmd, posix_spawn_file_actions_t *fa)
+{
+    const char **argv, **a;
+    char *s;
+    char *cmd;
+    const Size_t cmdlen = strlen(incmd) + 1;
+    Pid_t pid = -1;
+    posix_spawn_file_actions_t own;
+    int have_own = 0;
+
+    ENTER;
+    Newx(cmd, cmdlen, char);
+    SAVEFREEPV(cmd);
+    memcpy(cmd, incmd, cmdlen);
+    while (*cmd && isSPACE(*cmd))
+        cmd++;
+
+    if (*cmd == '.' && isSPACE(cmd[1]))
+        goto doshell;
+    if (strBEGINs(cmd,"exec") && isSPACE(cmd[4]))
+        goto doshell;
+    s = cmd;
+    while (isWORDCHAR(*s))
+        s++;	/* catch VAR=val gizmo */
+    if (*s == '=')
+        goto doshell;
+
+    for (s = cmd; *s; s++) {
+        if (*s != ' ' && !isALPHA(*s) &&
+            memCHRs("$&*(){}[]'\";\\|?<>~`\n",*s)) {
+            if (*s == '\n' && !s[1]) {
+                *s = '\0';
+                break;
+            }
+            /* the 2>&1 construct at the end: the child's dup2 */
+            if (*s == '>' && s[1] == '&' && s[2] == '1'
+                && s > cmd + 1 && s[-1] == '2' && isSPACE(s[-2])
+                && (!s[3] || isSPACE(s[3])))
+            {
+                const char *t = s + 3;
+
+                while (*t && isSPACE(*t))
+                    ++t;
+                if (!*t) {
+                    if (!fa) {
+                        posix_spawn_file_actions_init(&own);
+                        have_own = 1;
+                        fa = &own;
+                    }
+                    posix_spawn_file_actions_adddup2(fa, 1, 2);
+                    s[-2] = '\0';
+                    break;
+                }
+            }
+          doshell:
+            pid = S_wasm_spawn_sh(aTHX_ cmd, fa);
+            goto leave;
+        }
+    }
+
+    Newx(argv, (s - cmd) / 2 + 2, const char*);
+    SAVEFREEPV(argv);
+    cmd = savepvn(cmd, s-cmd);
+    SAVEFREEPV(cmd);
+    a = argv;
+    for (s = cmd; *s;) {
+        while (isSPACE(*s))
+            s++;
+        if (*s)
+            *(a++) = s;
+        while (*s && !isSPACE(*s))
+            s++;
+        if (*s)
+            *s++ = '\0';
+    }
+    *a = NULL;
+    if (argv[0]) {
+        pid = S_wasm_spawnv(aTHX_ argv[0], argv, fa);
+        if (pid == -1 && errno == ENOEXEC) {
+            pid = S_wasm_spawn_sh(aTHX_ incmd, fa);
+            goto leave;
+        }
+        if (pid == -1)
+            ck_warner(packWARN(WARN_EXEC), "Can't exec \"%s\": %s", argv[0], Strerror(errno));
+    }
+    else
+        errno = ENOENT;
+  leave:
+    if (have_own)
+        posix_spawn_file_actions_destroy(&own);
+    LEAVE;
+    return pid;
+}
+
+/* do_aexec5's: the list (mark, sp], `really` the program to run if given */
+Pid_t
+Perl_wasm_aspawn(pTHX_ SV *really, SV **mark, SV **sp, posix_spawn_file_actions_t *fa)
+{
+    const char **argv, **a;
+    const char *tmps = NULL;
+    Pid_t pid = -1;
+
+    ENTER;
+    Newx(argv, sp - mark + 1, const char*);
+    SAVEFREEPV(argv);
+    a = argv;
+    while (++mark <= sp) {
+        if (*mark) {
+            char *arg = savepv(SvPV_nolen_const(*mark));
+            SAVEFREEPV(arg);
+            *a++ = arg;
+        } else
+            *a++ = "";
+    }
+    *a = NULL;
+    if (really) {
+        tmps = savepv(SvPV_nolen_const(really));
+        SAVEFREEPV(tmps);
+    }
+    if ((!really && argv[0] && *argv[0] != '/') ||
+        (really && *tmps != '/'))		/* will execvp use PATH? */
+        TAINT_ENV();
+    if (really && *tmps)
+        pid = S_wasm_spawnv(aTHX_ tmps, argv, fa);
+    else if (argv[0])
+        pid = S_wasm_spawnv(aTHX_ argv[0], argv, fa);
+    else
+        SETERRNO(ENOENT,RMS_FNF);
+    if (pid == -1)
+        ck_warner(packWARN(WARN_EXEC), "Can't exec \"%s\": %s",
+                  really ? tmps : argv[0] ? argv[0] : "", Strerror(errno));
+    LEAVE;
+    return pid;
+}
+
+/* system()'s wait, as its fork path waits: SIGINT and SIGQUIT ignored meanwhile */
+static int
+S_wasm_system_wait(pTHX_ Pid_t pid)
+{
+    Sigsave_t ihand, qhand;
+    int status;
+    I32 result;
+
+    if (pid == -1) {
+        PL_statusvalue = -1;	/* pp_system returns it as is */
+        return -1;
+    }
+    rsignal_save(SIGINT,  (Sighandler_t) SIG_IGN, &ihand);
+    rsignal_save(SIGQUIT, (Sighandler_t) SIG_IGN, &qhand);
+    do {
+        result = wait4pid(pid, &status, 0);
+    } while (result == -1 && errno == EINTR);
+    (void)rsignal_restore(SIGINT, &ihand);
+    (void)rsignal_restore(SIGQUIT, &qhand);
+    return result == -1 ? -1 : status;
+}
+
+/* pp_system's non-fork path calls these, as it does Windows' and VMS' own. system(1, LIST)
+ * is Windows' P_NOWAIT, which IPC::Open3 spawns with where there is no fork: the child is not
+ * waited for, and system returns its pid; a single command line goes through do_exec3's rules
+ * (the shell if it needs one), as system's does. */
+int
+do_aspawn(SV *really, void **mark, void **sp)
+{
+    dTHX;
+    SV **m = (SV **)mark;
+
+    if ((SV **)sp - m > 1 && SvNIOKp(m[1]) && !SvPOKp(m[1]) && SvIV(m[1]) == 1) {
+        const Pid_t pid = (SV **)sp - m == 2 && !really
+            ? Perl_wasm_spawn3(aTHX_ SvPV_nolen(m[2]), NULL)
+            : Perl_wasm_aspawn(aTHX_ really, m + 1, (SV **)sp, NULL);
+        PL_statusvalue = -1;	/* pp_system returns it as is */
+        return pid;
+    }
+    return S_wasm_system_wait(aTHX_ Perl_wasm_aspawn(aTHX_ really, m, (SV **)sp, NULL));
+}
+
+int
+do_spawn(char *cmd)
+{
+    dTHX;
+    return S_wasm_system_wait(aTHX_ Perl_wasm_spawn3(aTHX_ cmd, NULL));
+}
+#endif /* __wasm__ */
