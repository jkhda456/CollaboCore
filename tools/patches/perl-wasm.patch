+#ifdef __wasm__
+/* collaboCore: my_popen and my_popen_list without fork() (see doio.c): the child starts with
+ * posix_spawn, its end of the pipe on its standard output ('r') or input ('w'); the parent
+ * keeps the lower of the two descriptors and records the pid for my_pclose, as after a fork. */
+static PerlIO *
+S_wasm_popen(pTHX_ const char *cmd, int n, SV **args, const char *mode)
+{
+    int p[2];
+    const I32 This = (*mode == 'w');
+    const I32 that = !This;
+    posix_spawn_file_actions_t fa;
+    Pid_t pid;
+    SV *sv;
+
+    PERL_FLUSHALL_FOR_CHILD;
+    if (TAINTING_get) {
+        taint_env();
+        taint_proper("Insecure %s%s", "EXEC");
+    }
+    if (PerlProc_pipe_cloexec(p) < 0)
+        return NULL;
+    posix_spawn_file_actions_init(&fa);
+    posix_spawn_file_actions_adddup2(&fa, p[that], *mode == 'r');
+    pid = cmd ? Perl_wasm_spawn3(aTHX_ cmd, &fa)
+              : Perl_wasm_aspawn(aTHX_ NULL, args - 1, args - 1 + n, &fa);
+    posix_spawn_file_actions_destroy(&fa);
+    if (pid == -1) {
+        const int e = errno;
+        PerlLIO_close(p[0]);
+        PerlLIO_close(p[1]);
+        errno = e;
+        return NULL;
+    }
+    if (p[that] < p[This]) {
+        PerlLIO_dup2_cloexec(p[This], p[that]);
+        PerlLIO_close(p[This]);
+        p[This] = p[that];
+    }
+    else
+        PerlLIO_close(p[that]);
+    sv = *av_fetch(PL_fdpid,p[This],TRUE);
+    SvUPGRADE(sv,SVt_IV);
+    SvIV_set(sv, pid);
+    PL_forkprocess = pid;
+    return PerlIO_fdopen(p[This], mode);
+}
+#endif /* __wasm__ */
