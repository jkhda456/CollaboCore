+static pid_t SpawnBackend(char **argv)
+{
+	char exe[MAXPATHLEN];
+	char **env, **ep;
+	ssize_t len;
+	pid_t pid;
+	int err;
+
+	for (ep = environ; *ep; ep++) ;
+	if (!(env = malloc((ep - environ + 2) * sizeof(char *))))
+		Panic(0, "%s", strnomem);
+	env[0] = BACKEND_ENV "=1";
+	memcpy(env + 1, environ, (ep - environ + 1) * sizeof(char *));
+	if ((len = readlink("/proc/self/exe", exe, sizeof(exe) - 1)) > 0) {
+		exe[len] = 0;
+		err = posix_spawn(&pid, exe, NULL, NULL, argv, env);
+	} else
+		err = posix_spawnp(&pid, argv[0], NULL, NULL, argv, env);
+	free(env);
+	if (err) {
+		errno = err;
+		return -1;
+	}
+	return pid;
+}
