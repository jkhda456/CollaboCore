 /*
+ * There is no fork() here (Linux compiled to WebAssembly has no MMU). A child starts the way
+ * posix_spawn starts one: clone(CLONE_VM | CLONE_VFORK) runs fn on a stack of its own, in our
+ * memory, while we wait until it calls exec or exits. So fn may only make system calls and exec:
+ * whatever it writes, it writes into our memory, so no stdio, malloc, Msg() or Panic() there, and
+ * a failure goes through ChildFail for the parent to report. Signals stay blocked until the ones
+ * we catch are back at their default.
+ */
+#define SPAWN_STACK (64 * 1024)
+
+struct spawnctx {
+	int (*fn)(void *);
+	void *arg;
+	sigset_t mask;
+};
+
+static int SpawnEntry(void *p)
+{
+	struct spawnctx *ctx = p;
+	struct sigaction sa;
+
+	for (int sig = 1; sig < _NSIG; sig++)
+		if (sigaction(sig, NULL, &sa) == 0 && sa.sa_handler != SIG_DFL && sa.sa_handler != SIG_IGN) {
+			memset(&sa, 0, sizeof(sa));
+			sa.sa_handler = SIG_DFL;
+			sigaction(sig, &sa, NULL);
+		}
+	sigprocmask(SIG_SETMASK, &ctx->mask, NULL);
+	return ctx->fn(ctx->arg);
+}
+
+pid_t SpawnChild(int (*fn)(void *), void *arg)
+{
+	struct spawnctx ctx;
+	sigset_t all;
+	char *stack;
+	pid_t pid;
+	int err;
+
+	if (!(stack = malloc(SPAWN_STACK)))
+		return -1;
+	ctx.fn = fn;
+	ctx.arg = arg;
+	sigfillset(&all);
+	sigprocmask(SIG_BLOCK, &all, &ctx.mask);
+	pid = clone(SpawnEntry, stack + SPAWN_STACK, CLONE_VM | CLONE_VFORK | SIGCHLD, &ctx);
+	err = errno;
+	sigprocmask(SIG_SETMASK, &ctx.mask, NULL);
+	free(stack);
+	errno = err;
+	return pid;
+}
+
+void ChildFail(struct childerr *e, const char *fmt, const char *arg)
+{
+	e->err = errno;
+	e->arg = arg;
+	e->fmt = fmt;
+	_exit(127);
+}
