+#ifdef _Py_WASM_CALL_TRAMPOLINE
+
+/* Calls through a function pointer of another type (pycore_emscripten_trampoline.h). C leaves a
+ * call through a pointer of a type the function does not have undefined, and native ABIs ignore
+ * the arguments a function does not take: extension modules declare METH_NOARGS methods without
+ * their unused second parameter, getters without the closure. WebAssembly's call_indirect checks
+ * the type exactly and traps ("indirect call type mismatch"), so a function of a library is called
+ * with the number of parameters it has, which the engine reads from its table slot (the dylink
+ * calls, engine/src/dylink.rs). A host without those calls says ENOSYS (it loads no libraries
+ * either): every function is then called as declared. */
+
+#define DYLINK_SYSCALL 0x7d000000
+enum { DL_PARAMS = 8, DL_OWN_TABLE = 9 };
+
+uintptr_t _PyWasm_own_functions;
+
+void
+_PyWasm_Trampoline_Init(void)
+{
+    int saved = errno;
+    long n = syscall(DYLINK_SYSCALL + DL_OWN_TABLE);
+    errno = saved;
+    _PyWasm_own_functions = n < 0 ? UINTPTR_MAX : (uintptr_t)n;
+}
+
+/* What the engine said of a table slot, direct-mapped: slot << 8 | code, the code being the
+ * number of parameters + 1, or PARAMS_UNKNOWN: not a function of i32 parameters and an i32
+ * result (or no answer), called as declared. Slots past 2^24 are not kept. */
+#define PARAMS_CACHE 4096
+#define PARAMS_UNKNOWN 0xff
+static uint32_t params_cache[PARAMS_CACHE];
+
+static int
+func_params(void (*func)(void), int declared)
+{
+    uintptr_t slot = (uintptr_t)func;
+    uint32_t *entry = &params_cache[slot % PARAMS_CACHE];
+    uint32_t e = _Py_atomic_load_uint32_relaxed(entry);
+    uint32_t code;
+    if (e != 0 && e >> 8 == slot) {
+        code = e & 0xff;
+    }
+    else {
+        int saved = errno;
+        long n = syscall(DYLINK_SYSCALL + DL_PARAMS, (long)slot);
+        errno = saved;
+        code = n < 0 || n >= PARAMS_UNKNOWN - 1 ? PARAMS_UNKNOWN : (uint32_t)n + 1;
+        if (slot < (1u << 24)) {
+            _Py_atomic_store_uint32_relaxed(entry, (uint32_t)slot << 8 | code);
+        }
+    }
+    return code == PARAMS_UNKNOWN ? declared : (int)code - 1;
+}
+
+typedef PyObject *(*zero_arg)(void);
+typedef PyObject *(*one_arg)(PyObject *);
+typedef PyObject *(*two_arg)(PyObject *, PyObject *);
+typedef PyObject *(*three_arg)(PyObject *, PyObject *, PyObject *);
+
+PyObject *
+_PyWasm_TrampolineCall(void (*func)(void), PyObject *a, PyObject *b, PyObject *c, int declared)
+{
+    switch (func_params(func, declared)) {
+    case 0:
+        return ((zero_arg)func)();
+    case 1:
+        return ((one_arg)func)(a);
+    case 2:
+        return ((two_arg)func)(a, b);
+    case 3:
+        return ((three_arg)func)(a, b, c);
+    default:
+        PyErr_SetString(PyExc_SystemError, "Handler takes too many arguments");
+        return NULL;
+    }
+}
+
+int
+_PyWasm_SetterCall(setter set, PyObject *obj, PyObject *value, void *closure)
+{
+    switch (func_params((void (*)(void))set, 3)) {
+    case 2:
+        return ((int (*)(PyObject *, PyObject *))(void (*)(void))set)(obj, value);
+    case 3:
+        return set(obj, value, closure);
+    default:
+        PyErr_SetString(PyExc_SystemError, "Setter takes too few or too many arguments");
+        return -1;
+    }
+}
